@model Reserve
@{
    ViewData["Title"] = "Yeni rezervasiya";
}

<div class="page-head">
    <div>
        <h2>Yeni rezervasiya</h2>
        <p>Xəstə məlumatlarını və müayinə növlərini daxil edin</p>
    </div>
    <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Siyahıya qayıt</a>
</div>

<div class="card">
    <div class="card-pad">
        <form asp-action="Add" method="post">
            <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <div class="form-grid">
                <div class="field">
                    <label asp-for="Name">Ad</label>
                    <input asp-for="Name" class="form-control" placeholder="Ad" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Surname">Soyad</label>
                    <input asp-for="Surname" class="form-control" placeholder="Soyad" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="PinCode">FİN kod</label>
                    <input asp-for="PinCode" class="form-control" placeholder="AB12345" />
                    <span asp-validation-for="PinCode" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Phone">Əlaqə nömrəsi</label>
                    <input asp-for="Phone" class="form-control" placeholder="050 123 45 67" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Birthday">Doğum tarixi</label>
                    <input asp-for="Birthday" type="date" class="form-control" />
                    <span asp-validation-for="Birthday" class="text-danger"></span>
                </div>
            </div>

            <div class="field mt-3">
                <label>Müayinə növləri</label>
                <div class="chip-group">
                    @foreach (var item in ViewBag.ExaminationTypes)
                    {
                        <label class="chip">
                            <input type="checkbox" name="ReserveExaminationTypesId" value="@item.Id" />
                            <i class="bi bi-clipboard2-pulse"></i> @item.Name
                            <span class="text-muted" style="font-size:.8rem;">(@item.Price ₼)</span>
                        </label>
                    }
                </div>
                @if (((IEnumerable<dynamic>)ViewBag.ExaminationTypes).Cast<object>().Count() == 0)
                {
                    <p class="text-muted" style="font-size:.85rem;">Hələ müayinə növü yoxdur. Əvvəlcə müayinə əlavə edin.</p>
                }
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Rezervasiyanı yarat</button>
            </div>
        </form>
    </div>
</div>
