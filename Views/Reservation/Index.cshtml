@model List<Reserve>
@{
    ViewData["Title"] = "Rezervasiyalar";
    var q = ViewBag.Query as string;
    var period = ViewBag.Period as string ?? "upcoming";
    var status = ViewBag.Status as string;
    var doctorId = ViewBag.DoctorId as int?;
    var doctors = (List<Doctor>)ViewBag.Doctors;
    var periods = new (string Key, string Label)[]
    {
        ("today", "Bu gün"), ("tomorrow", "Sabah"), ("week", "7 gün"),
        ("upcoming", "Gələcək"), ("past", "Keçmiş"), ("all", "Hamısı")
    };
    DateTime? lastDay = null;
    var grouped = period is not ("past" or "all");
    var now = DateTime.Now;
    ViewData["PrimaryOnly"] = true;
}

<div class="page-head">
    <div>
        <h2>Rezervasiyalar</h2>
        <p>@Model.Count rezervasiya@(string.IsNullOrWhiteSpace(q) ? "" : $" · «{q}» üzrə")@(Model.Count >= 500 ? " (ilk 500)" : "")</p>
    </div>
</div>

<form method="get" class="toolbar" role="search">
    <div class="seg seg-scroll">
        @foreach (var p in periods)
        {
            <a class="@(period == p.Key ? "on" : "")" asp-action="Index" asp-route-period="@p.Key" asp-route-status="@status" asp-route-doctorId="@(doctorId?.ToString() ?? "")" asp-route-q="@q">@p.Label</a>
        }
    </div>
    <input type="hidden" name="period" value="@period" />
    <div class="toolbar-right">
        <select name="doctorId" class="form-select" aria-label="Həkim" onchange="this.form.submit()" style="width:auto; max-width:240px;">
            <option value="" selected="@(doctorId == null)">Bütün həkimlər</option>
            @foreach (var d in doctors)
            {
                <option value="@d.Id" selected="@(doctorId == d.Id)">@d.FullName@(d.IsActive ? "" : " (deaktiv)")</option>
            }
        </select>
        <select name="status" class="form-select" aria-label="Status" onchange="this.form.submit()" style="width:auto;">
            <option value="" selected="@(string.IsNullOrEmpty(status))">Bütün statuslar</option>
            @foreach (var s in StatusNames.All)
            {
                <option value="@s" selected="@(status == s)">@StatusNames.Label(s)</option>
            }
        </select>
        <div class="search">
            <i class="bi bi-search"></i>
            <input type="search" name="q" value="@q" class="form-control" placeholder="Ad, FİN və ya telefon..." aria-label="Axtarış" />
        </div>
    </div>
</form>

@if (Model.Any())
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Qəbul vaxtı</th>
                    <th>Xəstə</th>
                    <th>Həkim</th>
                    <th>Telefon</th>
                    <th>Status</th>
                    <th class="actions">Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    if (grouped && lastDay != item.AppointmentAt.Date)
                    {
                        lastDay = item.AppointmentAt.Date;
                        <tr class="group-row"><td colspan="6">@Fmt.Day(item.AppointmentAt) · @Fmt.Long(item.AppointmentAt)</td></tr>
                    }
                    var closed = StatusNames.IsClosedWithoutVisit(item.Status?.Name);
                    <tr class="@(closed ? "row-muted" : "")">
                        <td>
                            @if (grouped)
                            {
                                <span class="time-pill">@Fmt.Time(item.AppointmentAt)</span>
                            }
                            else
                            {
                                <span style="font-weight:600;">@Fmt.Appointment(item.AppointmentAt)</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Patient" asp-action="Details" asp-route-id="@item.PatientId" class="link-strong">@item.Patient.FullName</a>
                            <div class="hint-text">@item.Patient.PinCode</div>
                        </td>
                        <td>
                            @if (item.Doctor != null)
                            {
                                <div>@item.Doctor.FullName</div>
                                <div class="hint-text">@item.Room?.Name</div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-muted">@item.Patient.Phone</td>
                        <td><partial name="_StatusBadge" model="item.Status?.Name" /></td>
                        <td class="actions">
                            <div class="actions-inner">
                                <partial name="_StatusActions" model="item" />
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-ghost btn-sm">
                                    <i class="bi bi-eye"></i> Detallar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-calendar2-x"></i>
            <p>Bu filtrə uyğun rezervasiya yoxdur</p>
            @if (User.Can(Permissions.ReservationsManage))
            {
                <a class="btn btn-primary mt-3" asp-action="Add"><i class="bi bi-plus-lg"></i> Yeni rezervasiya</a>
            }
        </div>
    </div>
}
