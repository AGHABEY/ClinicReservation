@model KassaListViewModel
@{
    ViewData["Title"] = "Kassa";
    var isAdmin = User.IsInRole(AppRoles.Admin);
    string statusBadge(string s) => s switch { "Paid" => "badge-paid", "Partial" => "badge-partial", _ => "badge-unpaid" };
    string statusText(string s) => s switch { "Paid" => "Ödənilib", "Partial" => "Qismən", _ => "Ödənilməyib" };
}

<div class="page-head">
    <div>
        <h2>Kassa</h2>
        <p>Rezervasiyalar üzrə ödənişlər</p>
    </div>
</div>

@if (User.IsInRole(AppRoles.Admin))
{
    <div class="stat-grid">
        <div class="stat">
            <div class="icon teal"><i class="bi bi-wallet2"></i></div>
            <div>
                <div class="value">@Model.TotalExpected.ToString("0.00") ₼</div>
                <div class="label">Gözlənilən gəlir</div>
            </div>
        </div>
        <div class="stat">
            <div class="icon green"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="value">@Model.TotalCollected.ToString("0.00") ₼</div>
                <div class="label">Yığılan</div>
            </div>
        </div>
        <div class="stat">
            <div class="icon amber"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="value">@Model.TotalOutstanding.ToString("0.00") ₼</div>
                <div class="label">Qalıq borc</div>
            </div>
        </div>
    </div>
}

<div class="flex-between mb-3">
    <div class="seg">
        <a class="@(string.IsNullOrEmpty(Model.Filter) ? "on" : "")" asp-action="Index">Hamısı</a>
        <a class="@(Model.Filter == "unpaid" ? "on" : "")" asp-action="Index" asp-route-filter="unpaid">Ödənilməyib</a>
        <a class="@(Model.Filter == "paid" ? "on" : "")" asp-action="Index" asp-route-filter="paid">Ödənilib</a>
    </div>
</div>

@if (Model.Items.Any())
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Xəstə</th>
                    <th>Telefon</th>
                    @if (isAdmin)
                    {
                        <th style="text-align:right;">Cəmi</th>
                        <th style="text-align:right;">Ödənilib</th>
                        <th style="text-align:right;">Qalıq</th>
                    }
                    <th>Status</th>
                    <th style="text-align:right;">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td style="font-weight:600;">@item.Reserve.Name @item.Reserve.Surname</td>
                        <td class="text-muted">@item.Reserve.Phone</td>
                        @if (isAdmin)
                        {
                            <td style="text-align:right;" class="money">@item.Total.ToString("0.00") ₼</td>
                            <td style="text-align:right;" class="money pos">@item.Paid.ToString("0.00") ₼</td>
                            <td style="text-align:right;" class="money @(item.Balance > 0 ? "neg" : "")">@item.Balance.ToString("0.00") ₼</td>
                        }
                        <td><span class="badge-soft @statusBadge(item.PaymentStatus)">@statusText(item.PaymentStatus)</span></td>
                        <td style="text-align:right;">
                            <a class="btn @(item.PaymentStatus == "Paid" ? "btn-light" : "btn-primary") btn-sm" asp-action="Pay" asp-route-id="@item.Reserve.Id">
                                <i class="bi bi-cash-coin"></i> @(item.PaymentStatus == "Paid" ? "Bax" : "Ödəniş")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-cash-coin"></i>
            <p>Bu filtrə uyğun rezervasiya yoxdur</p>
        </div>
    </div>
}
