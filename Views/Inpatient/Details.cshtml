@model AdmissionViewModel
@{
    var a = Model.Admission;
    var p = a.Patient;
    var now = DateTime.Now;
    var active = a.IsActive;
    var canDoc = User.Can(Permissions.InpatientDoctor);
    var canNurse = User.Can(Permissions.InpatientNurse);
    var canManage = User.Can(Permissions.InpatientManage);
    ViewData["Title"] = $"{p.FullName} · {a.Number}";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var tabs = new[] { ("journal", "Gündəlik", "bi-journal-medical"), ("orders", "Təyinatlar", "bi-capsule"), ("mar", "Dərman icrası", "bi-check2-square"), ("bill", "Yataq-gün", "bi-receipt") };
    var dayStr = Model.Day.ToString("yyyy-MM-dd");
}

<div class="page-head">
    <div>
        <h2>@p.FullName</h2>
        <p>
            @a.Number · @(a.Department?.Name ?? "Şöbəsiz")@(a.Bed != null ? " · " + a.Bed.Label : "") · @Fmt.Ordinal(a.Day(now)) gün
            @if (a.Status == AdmissionStatus.Discharged) { <span class="badge-soft badge-completed" style="margin-left:6px;">Çıxarılıb</span> }
            else if (a.Status == AdmissionStatus.Cancelled) { <span class="badge-soft badge-cancelled" style="margin-left:6px;">Ləğv edilib</span> }
            else if (a.Type == AdmissionType.Emergency) { <span class="badge-soft badge-unpaid" style="margin-left:6px;">Təcili</span> }
        </p>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Xəritə</a>
        @if (User.Can(Permissions.PatientsView))
        {
            <a class="btn btn-light" asp-controller="Patient" asp-action="Details" asp-route-id="@p.Id"><i class="bi bi-person-vcard"></i> Xəstə kartı</a>
        }
        @if (active && canManage)
        {
            <button type="button" class="btn btn-light" onclick="document.getElementById('moveDialog').showModal()"><i class="bi bi-arrow-left-right"></i> Çarpayını dəyiş</button>
        }
        @if (!active && a.Status == AdmissionStatus.Discharged)
        {
            <a class="btn btn-primary" asp-action="Epicrisis" asp-route-id="@a.Id"><i class="bi bi-file-earmark-medical"></i> Epikriz</a>
        }
        @if (active && canDoc)
        {
            <a class="btn btn-primary" asp-action="Discharge" asp-route-id="@a.Id"><i class="bi bi-box-arrow-right"></i> Çıxarış</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(p.Allergies))
{
    <div class="med-alert" style="margin-bottom:12px;"><i class="bi bi-exclamation-octagon-fill"></i><span><strong>Allergiya:</strong> @p.Allergies</span></div>
}
@if (!string.IsNullOrWhiteSpace(p.ChronicConditions))
{
    <div class="med-alert chronic" style="margin-bottom:20px;"><i class="bi bi-heart-pulse-fill"></i><span><strong>Xroniki:</strong> @p.ChronicConditions</span></div>
}
@if (Model.Errors.Any())
{
    <div class="alert alert-danger"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
}

<div class="detail-grid">
    <div class="stack" style="gap:16px;">
        <div class="seg seg-scroll">
            @foreach (var (key, label, icon) in tabs)
            {
                <a class="@(Model.Tab == key ? "on" : "")" asp-action="Details" asp-route-id="@a.Id" asp-route-tab="@key"><i class="bi @icon"></i> @label</a>
            }
        </div>

        @* ================= Gündəlik ================= *@
        @if (Model.Tab == "journal")
        {
            var obs = a.Observations.OrderByDescending(o => o.At).ToList();
            var temps = a.Observations.Where(o => o.Temperature != null).OrderBy(o => o.At).TakeLast(30).ToList();
            var o = Model.NewObservation;
            if (active && (canDoc || canNurse))
            {
                <div class="card card-pad">
                    <form asp-action="Observe" method="post" novalidate>
                        <input type="hidden" name="AdmissionId" value="@a.Id" />
                        @if (canDoc && canNurse || canDoc)
                        {
                            <div class="chip-group" style="margin-bottom:12px;">
                                <label class="chip"><input type="radio" name="Kind" value="@ObservationKind.Doctor" checked="@(o.Kind == ObservationKind.Doctor)" /> Həkim gündəliyi</label>
                                <label class="chip"><input type="radio" name="Kind" value="@ObservationKind.Nurse" checked="@(o.Kind == ObservationKind.Nurse)" /> Vital göstəricilər / tibb bacısı</label>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="Kind" value="@ObservationKind.Nurse" />
                        }
                        <div class="vitals-row">
                            <div class="field"><label for="Temperature">T, °C</label><input id="Temperature" name="Temperature" value="@o.Temperature?.ToString("0.0", inv)" type="number" step="0.1" min="30" max="45" class="form-control" /></div>
                            <div class="field"><label for="BpSystolic">AT, mm c.s.</label>
                                <div style="display:flex; gap:4px; align-items:center;"><input id="BpSystolic" name="BpSystolic" value="@o.BpSystolic" type="number" min="50" max="300" class="form-control" aria-label="Sistolik" /><span>/</span><input name="BpDiastolic" value="@o.BpDiastolic" type="number" min="20" max="200" class="form-control" aria-label="Diastolik" /></div>
                            </div>
                            <div class="field"><label for="Pulse">Nəbz</label><input id="Pulse" name="Pulse" value="@o.Pulse" type="number" min="20" max="250" class="form-control" /></div>
                            <div class="field"><label for="RespRate">Tənəffüs</label><input id="RespRate" name="RespRate" value="@o.RespRate" type="number" min="4" max="80" class="form-control" /></div>
                            <div class="field"><label for="SpO2">SpO₂, %</label><input id="SpO2" name="SpO2" value="@o.SpO2" type="number" min="50" max="100" class="form-control" /></div>
                        </div>
                        <div class="field mt-3">
                            <label for="Text">Qeyd</label>
                            <textarea id="Text" name="Text" class="form-control" rows="4" maxlength="4000" placeholder="Vəziyyəti, şikayətlər, obyektiv müayinə, plan …">@o.Text</textarea>
                        </div>
                        <div class="form-actions" style="margin-top:12px;"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Yadda saxla</button></div>
                    </form>
                </div>
            }

            @if (temps.Count >= 2)
            {
                const double W = 640, H = 170, L = 34, R = 10, T = 12, B = 24;
                double lo = 35, hi = 41;
                var t0 = temps.First().At; var t1 = temps.Last().At;
                var span = Math.Max(1, (t1 - t0).TotalMinutes);
                string X(DateTime d) => (L + (W - L - R) * (d - t0).TotalMinutes / span).ToString("0.#", inv);
                string Y(decimal v) => (T + (H - T - B) * (hi - Math.Clamp((double)v, lo, hi)) / (hi - lo)).ToString("0.#", inv);
                var pts = string.Join(" ", temps.Select(t => $"{X(t.At)},{Y(t.Temperature!.Value)}"));
                <div class="card card-pad">
                    <h3 class="card-title"><i class="bi bi-thermometer-half"></i> Temperatur</h3>
                    <svg viewBox="0 0 @W @H" class="temp-chart" role="img" aria-label="Temperatur qrafiki">
                        @foreach (var g in new[] { 36, 37, 38, 39, 40 })
                        {
                            <line x1="@L" x2="@(W - R)" y1="@Y(g)" y2="@Y(g)" class="@(g == 37 ? "grid ref" : "grid")" />
                            @Html.Raw($"<text x=\"{L - 6}\" y=\"{Y(g)}\" class=\"axis\" text-anchor=\"end\" dominant-baseline=\"middle\">{g}</text>")
                        }
                        <polyline points="@pts" class="line" />
                        @foreach (var t in temps)
                        {
                            <circle cx="@X(t.At)" cy="@Y(t.Temperature!.Value)" r="3.5" class="@(t.Temperature >= 37.5m ? "dot hot" : "dot")"><title>@Fmt.DateTime(t.At): @t.Temperature.Value.ToString("0.0", Fmt.Az) °C</title></circle>
                        }
                        @Html.Raw($"<text x=\"{L}\" y=\"{H - 4}\" class=\"axis\">{Fmt.DateTime(t0)}</text>")
                        @Html.Raw($"<text x=\"{W - R}\" y=\"{H - 4}\" class=\"axis\" text-anchor=\"end\">{Fmt.DateTime(t1)}</text>")
                    </svg>
                </div>
            }

            <div class="card">
                <div class="card-head"><h3 class="card-title"><i class="bi bi-journal-medical"></i> Qeydlər</h3><span class="hint-text">@obs.Count</span></div>
                @if (obs.Any())
                {
                    <div class="obs-list">
                        @foreach (var x in obs)
                        {
                            <div class="obs @(x.Kind == ObservationKind.Doctor ? "doc" : "nurse")">
                                <div class="obs-head">
                                    <span class="badge-soft @(x.Kind == ObservationKind.Doctor ? "badge-completed" : "badge-arrived")">@(x.Kind == ObservationKind.Doctor ? "Həkim" : "Tibb bacısı")</span>
                                    <span class="hint-text">@Fmt.DateTime(x.At) · @x.Author</span>
                                </div>
                                @if (x.HasVitals)
                                {
                                    <div class="obs-vitals">@ClinicReservation.Controllers.InpatientController.Vitals(x)</div>
                                }
                                @if (x.Text != null)
                                {
                                    <div class="obs-text">@x.Text</div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state"><i class="bi bi-journal"></i><p>Hələ qeyd yoxdur</p></div>
                }
            </div>
        }

        @* ================= Təyinatlar ================= *@
        @if (Model.Tab == "orders")
        {
            var no = Model.NewOrder;
            if (active && canDoc)
            {
                var customTimes = no.Times != null && !InpatientLabels.Schedules.Any(s => s.Times == no.Times);
                <div class="card card-pad">
                    <h3 class="card-title"><i class="bi bi-plus-circle"></i> Yeni təyinat</h3>
                    <form asp-action="Order" method="post" novalidate id="orderForm">
                        <input type="hidden" name="AdmissionId" value="@a.Id" />
                        <div class="form-grid">
                            <div class="field" style="grid-column: span 2;">
                                <label for="StockItemId">Dərman (aptekdən)</label>
                                <select id="StockItemId" name="StockItemId" class="form-select">
                                    <option value="">— kataloqda yoxdur, adını yazacağam —</option>
                                    @foreach (var m in Model.Medicines)
                                    {
                                        var have = Model.OnHand.GetValueOrDefault(m.Id);
                                        <option value="@m.Id" data-unit="@m.Unit" selected="@(no.StockItemId == m.Id)">@m.DisplayName — qalıq @StockService.Qty(have) @m.Unit</option>
                                    }
                                </select>
                            </div>
                            <div class="field" id="drugNameField">
                                <label for="DrugName">Dərmanın adı</label>
                                <input id="DrugName" name="DrugName" value="@no.DrugName" class="form-control" maxlength="200" />
                            </div>
                            <div class="field">
                                <label for="Dose">Doza</label>
                                <input id="Dose" name="Dose" value="@no.Dose" class="form-control" maxlength="50" placeholder="4 mq" />
                            </div>
                            <div class="field" id="qtyField">
                                <label for="QuantityPerDose">Hər dəfə anbardan <span class="hint-text" id="qtyUnit"></span></label>
                                <input id="QuantityPerDose" name="QuantityPerDose" value="@no.QuantityPerDose.ToString("0.###", inv)" type="number" step="any" min="0" class="form-control" />
                            </div>
                            <div class="field">
                                <label for="Route">Yeridilmə yolu</label>
                                <select id="Route" name="Route" class="form-select">
                                    <option value="">—</option>
                                    @foreach (var r in InpatientLabels.Routes) { <option value="@r" selected="@(no.Route == r)">@r</option> }
                                </select>
                            </div>
                            <div class="field">
                                <label for="sched">Qəbul qaydası</label>
                                <select id="sched" class="form-select">
                                    @foreach (var (label, times) in InpatientLabels.Schedules) { <option value="@times" selected="@(!customTimes && (no.Times ?? "") == times)">@label</option> }
                                    <option value="custom" selected="@customTimes">Başqa vaxtlar…</option>
                                </select>
                                <input type="hidden" name="Times" id="Times" value="@no.Times" />
                                <input id="timesCustom" class="form-control" style="margin-top:6px;" placeholder="09:00; 21:00" value="@(customTimes ? no.Times?.Replace(";", "; ") : "")" aria-label="Vaxtlar" />
                            </div>
                            <div class="field">
                                <label for="Days">Neçə gün <span class="hint-text">(boş — dayandırılana qədər)</span></label>
                                <input id="Days" name="Days" value="@no.Days" type="number" min="1" max="365" class="form-control" />
                            </div>
                        </div>
                        <div class="field mt-3">
                            <label for="Note">Qeyd</label>
                            <input id="Note" name="Note" value="@no.Note" class="form-control" maxlength="500" placeholder="məs. yeməkdən sonra, 200 ml NaCl 0.9%-də" />
                        </div>
                        <div class="form-actions" style="margin-top:12px;"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Təyin et</button></div>
                    </form>
                </div>
            }

            <div class="card">
                <div class="card-head"><h3 class="card-title"><i class="bi bi-capsule"></i> Təyinat vərəqi</h3></div>
                @if (a.Orders.Any())
                {
                    <div class="table-scroll">
                        <table class="data">
                            <thead><tr><th>Dərman</th><th>Qayda</th><th>Müddət</th><th class="num">Verilib</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var x in a.Orders.OrderBy(x => x.StoppedAt != null).ThenByDescending(x => x.OrderedAt))
                                {
                                    var stopped = x.StoppedAt != null;
                                    var finished = !stopped && x.EndDate != null && x.EndDate.Value.Date < DateTime.Today;
                                    <tr class="@(stopped || finished ? "row-muted" : "")">
                                        <td class="wrap">
                                            <span style="font-weight:600;">@x.Name</span> @x.Dose
                                            <div class="hint-text">@x.Route@(x.Note != null ? " · " + x.Note : "")@(x.StockItemId != null ? $" · anbardan {StockService.Qty(x.QuantityPerDose)} {x.StockItem!.Unit}" : "")</div>
                                        </td>
                                        <td style="white-space:nowrap;">@(x.IsPrn ? "Lazım olduqda" : string.Join(", ", x.TimeList.Select(t => t.ToString(@"hh\:mm"))))</td>
                                        <td style="white-space:nowrap;">
                                            @Fmt.Date(x.StartAt) – @(x.StoppedAt != null ? Fmt.Date(x.StoppedAt) : x.EndDate != null ? Fmt.Date(x.EndDate) : "…")
                                            <div class="hint-text">@x.OrderedBy@(stopped ? $" · dayandırdı: {x.StoppedBy}" : finished ? " · bitib" : "")</div>
                                        </td>
                                        <td class="num">@x.Doses.Count(d => d.Status == DoseStatus.Given)</td>
                                        <td class="actions">
                                            @if (!stopped && !finished && active && canDoc)
                                            {
                                                <form asp-action="StopOrder" method="post" data-confirm="«@x.Name» təyinatı dayandırılsın?">
                                                    <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="orderId" value="@x.Id" />
                                                    <button type="submit" class="btn btn-ghost btn-sm">Dayandır</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state"><i class="bi bi-capsule"></i><p>Təyinat yoxdur</p></div>
                }
            </div>
        }

        @* ================= Dərman icrası (MAR) ================= *@
        @if (Model.Tab == "mar")
        {
            var day = Model.Day;
            var first = a.AdmittedAt.Date;
            var last = (a.DischargedAt ?? DateTime.Today).Date;
            var orders = a.Orders.Where(x => x.IsActiveOn(day)).OrderBy(x => x.IsPrn).ThenBy(x => x.OrderedAt).ToList();
            <div class="card">
                <div class="card-head">
                    <h3 class="card-title"><i class="bi bi-check2-square"></i> @Fmt.Long(day)</h3>
                    <div style="display:flex; gap:6px;">
                        @if (day > first) { <a class="btn btn-light btn-sm" asp-action="Details" asp-route-id="@a.Id" asp-route-tab="mar" asp-route-day="@day.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Əvvəlki gün"><i class="bi bi-chevron-left"></i></a> }
                        @if (day != DateTime.Today && active) { <a class="btn btn-light btn-sm" asp-action="Details" asp-route-id="@a.Id" asp-route-tab="mar">Bu gün</a> }
                        @if (day < last) { <a class="btn btn-light btn-sm" asp-action="Details" asp-route-id="@a.Id" asp-route-tab="mar" asp-route-day="@day.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Növbəti gün"><i class="bi bi-chevron-right"></i></a> }
                    </div>
                </div>
                @if (orders.Any())
                {
                    <div class="mar">
                        @foreach (var x in orders)
                        {
                            var slots = x.SlotsOn(day).ToList();
                            var doses = x.Doses.Where(d => d.ScheduledAt.Date == day).ToDictionary(d => d.ScheduledAt);
                            <div class="mar-row">
                                <div class="mar-drug">
                                    <span style="font-weight:600;">@x.Name</span> @x.Dose
                                    <div class="hint-text">@x.Route@(x.IsPrn ? " · lazım olduqda" : "")</div>
                                </div>
                                <div class="mar-slots">
                                    @if (x.IsPrn)
                                    {
                                        foreach (var d in doses.Values.OrderBy(d => d.ScheduledAt))
                                        {
                                            <span class="dose given" title="@d.RecordedBy"><i class="bi bi-check-lg"></i> @Fmt.Time(d.ScheduledAt)</span>
                                        }
                                        if (active && canNurse && day == DateTime.Today && x.StoppedAt == null)
                                        {
                                            <form asp-action="Dose" method="post">
                                                <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="orderId" value="@x.Id" />
                                                <input type="hidden" name="status" value="@DoseStatus.Given" /><input type="hidden" name="day" value="@dayStr" />
                                                <button type="submit" class="btn btn-light btn-sm"><i class="bi bi-plus-lg"></i> İndi verildi</button>
                                            </form>
                                        }
                                        else if (!doses.Any())
                                        {
                                            <span class="hint-text">verilməyib</span>
                                        }
                                    }
                                    @foreach (var s in slots)
                                    {
                                        var slotStr = s.ToString("yyyy-MM-ddTHH:mm");
                                        if (doses.TryGetValue(s, out var d))
                                        {
                                            if (d.Status == DoseStatus.Given)
                                            {
                                                <span class="dose given" title="@Fmt.DateTime(d.RecordedAt) · @d.RecordedBy"><i class="bi bi-check-lg"></i> @Fmt.Time(s)</span>
                                            }
                                            else
                                            {
                                                <span class="dose skipped" title="@d.Note · @d.RecordedBy"><i class="bi bi-x-lg"></i> @Fmt.Time(s) <small>@d.Note</small></span>
                                            }
                                        }
                                        else
                                        {
                                            var overdue = s < now.AddHours(-1);
                                            var early = s > now.AddHours(2);
                                            if (active && canNurse && !early)
                                            {
                                                <span class="dose pending @(overdue ? "overdue" : "")">
                                                    <form asp-action="Dose" method="post" style="display:inline;">
                                                        <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="orderId" value="@x.Id" />
                                                        <input type="hidden" name="slot" value="@slotStr" /><input type="hidden" name="status" value="@DoseStatus.Given" /><input type="hidden" name="day" value="@dayStr" />
                                                        <button type="submit" class="dose-btn" title="Verildi kimi qeyd et"><i class="bi bi-circle"></i> @Fmt.Time(s)</button>
                                                    </form>
                                                    <details class="dose-skip">
                                                        <summary aria-label="Verilmədi"><i class="bi bi-three-dots"></i></summary>
                                                        <form asp-action="Dose" method="post" class="dose-skip-form">
                                                            <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="orderId" value="@x.Id" />
                                                            <input type="hidden" name="slot" value="@slotStr" /><input type="hidden" name="status" value="@DoseStatus.Skipped" /><input type="hidden" name="day" value="@dayStr" />
                                                            <select name="note" class="form-select" aria-label="Səbəb">
                                                                @foreach (var r in InpatientLabels.SkipReasons) { <option>@r</option> }
                                                            </select>
                                                            <button type="submit" class="btn btn-light btn-sm">Verilmədi</button>
                                                        </form>
                                                    </details>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="dose @(overdue ? "missed" : "planned")"><i class="bi bi-circle"></i> @Fmt.Time(s)</span>
                                            }
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <p class="hint-text" style="margin:0; padding:12px 20px 16px;"><i class="bi bi-info-circle"></i> Vaxta klikləyin — doza «verildi» kimi qeyd olunur və dərman anbardan silinir. «…» ilə verilmədiyini və səbəbini qeyd edin. Qırmızı — vaxtı 1 saatdan çox keçib.</p>
                }
                else
                {
                    <div class="empty-state"><i class="bi bi-capsule"></i><p>Bu gün üçün təyinat yoxdur</p></div>
                }
            </div>
        }

        @* ================= Yataq-gün ================= *@
        @if (Model.Tab == "bill")
        {
            var (lines, days, total) = InpatientService.BedDays(a, now);
            var meds = a.Orders.Select(x => (Order: x, Given: x.Doses.Count(d => d.Status == DoseStatus.Given))).Where(x => x.Given > 0).ToList();
            <div class="card">
                <div class="card-head"><h3 class="card-title"><i class="bi bi-receipt"></i> Yataq-gün</h3><span class="hint-text">@days gün</span></div>
                <div class="table-scroll">
                    <table class="data">
                        <thead><tr><th>Çarpayı</th><th>Dövr</th><th class="num">Gün</th><th class="num">Qiymət</th><th class="num">Məbləğ</th></tr></thead>
                        <tbody>
                            @foreach (var l in lines)
                            {
                                <tr>
                                    <td>@l.Stay.Bed.Label</td>
                                    <td style="white-space:nowrap;">@Fmt.DateTime(l.Stay.From) – @(l.Stay.To != null ? Fmt.DateTime(l.Stay.To) : "indi")</td>
                                    <td class="num">@l.Days</td>
                                    <td class="num money">@Fmt.Money(l.Stay.DailyPrice)</td>
                                    <td class="num money">@Fmt.Money(l.Amount)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr><td colspan="4" style="font-weight:600;">Cəmi yataq-gün</td><td class="num money" style="font-weight:700;">@Fmt.Money(total)</td></tr></tfoot>
                    </table>
                </div>
            </div>
            <div class="card">
                <div class="card-head"><h3 class="card-title"><i class="bi bi-capsule"></i> Verilmiş dərmanlar</h3></div>
                @if (meds.Any())
                {
                    <div class="line-list" style="padding:12px 20px 16px;">
                        @foreach (var (x, given) in meds)
                        {
                            <div class="line-item"><span>@x.Name @x.Dose</span><span class="hint-text">@given doza@(x.StockItemId != null ? $" · {StockService.Qty(given * x.QuantityPerDose)} {x.StockItem!.Unit}" : "")</span></div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state"><i class="bi bi-capsule"></i><p>Hələ dərman verilməyib</p></div>
                }
            </div>
            <p class="hint-text"><i class="bi bi-info-circle"></i> Yataq-gün gecələrlə sayılır (eyni gün çıxan xəstə üçün 1 gün). Qiymət palatanın sazlamasından götürülür. Stasionar ödənişi kassaya hələ bağlanmayıb — maliyyə modulunda əlavə olunacaq.</p>
        }
    </div>

    <div class="stack" style="gap:16px;">
        <div class="card card-pad">
            <h3 class="card-title"><i class="bi bi-info-circle"></i> Xəstəlik tarixi</h3>
            <dl class="detail-list">
                <div class="detail-row"><dt>Daxil olub</dt><dd>@Fmt.DateTime(a.AdmittedAt)</dd></div>
                <div class="detail-row"><dt>Növ</dt><dd>@InpatientLabels.Type(a.Type)</dd></div>
                <div class="detail-row"><dt>Həkim</dt><dd>@(a.Doctor?.FullName ?? "—")</dd></div>
                <div class="detail-row"><dt>Yaş, cins</dt><dd>@Fmt.Age(p.Birthday) yaş@(p.Gender != null ? ", " + Fmt.Gender(p.Gender).ToLower(Fmt.Az) : "")</dd></div>
                <div class="detail-row"><dt>Yerləşdirdi</dt><dd>@a.AdmittedBy</dd></div>
                @if (a.ReserveId != null && User.Can(Permissions.ReservationsView))
                {
                    <div class="detail-row"><dt>Göndəriş</dt><dd><a asp-controller="Reservation" asp-action="Details" asp-route-id="@a.ReserveId">Qəbul #@a.ReserveId</a></dd></div>
                }
                @if (a.Status == AdmissionStatus.Discharged)
                {
                    <div class="detail-row"><dt>Çıxıb</dt><dd>@Fmt.DateTime(a.DischargedAt)</dd></div>
                    <div class="detail-row"><dt>Nəticə</dt><dd>@InpatientLabels.Outcome(a.Outcome)</dd></div>
                }
                @if (a.Status == AdmissionStatus.Cancelled)
                {
                    <div class="detail-row"><dt>Ləğv səbəbi</dt><dd>@a.CancelReason</dd></div>
                }
            </dl>
            <div class="diagnosis-box" style="margin-top:12px;">
                <div class="hint-text">@(a.FinalDiagnosis != null ? "Yekun diaqnoz" : "Daxilolma diaqnozu")</div>
                <div>@if ((a.FinalIcdCode ?? a.AdmitIcdCode) is { } icd) { <span class="icd">@icd</span> } @(a.FinalDiagnosis ?? a.AdmitDiagnosis)</div>
            </div>
            @if (a.AdmitNote != null)
            {
                <p style="margin:12px 0 0; white-space:pre-line; font-size:14px;"><span class="hint-text">Şikayətlər:</span> @a.AdmitNote</p>
            }
        </div>

        @if (a.Stays.Count > 1)
        {
            <div class="card card-pad">
                <h3 class="card-title"><i class="bi bi-arrow-left-right"></i> Çarpayılar</h3>
                <ul class="timeline">
                    @foreach (var s in a.Stays.OrderBy(s => s.From))
                    {
                        <li><span>@s.Bed.Label</span><span class="hint-text">@Fmt.DateTime(s.From)</span></li>
                    }
                </ul>
            </div>
        }

        @if (Model.PreviousStays.Any())
        {
            <div class="card card-pad">
                <h3 class="card-title"><i class="bi bi-clock-history"></i> Əvvəlki yatışlar</h3>
                @foreach (var s in Model.PreviousStays)
                {
                    <a class="line-item quick-link" style="margin-bottom:8px;" asp-action="Details" asp-route-id="@s.Id">
                        <span style="min-width:0;">@Fmt.Date(s.AdmittedAt) – @Fmt.Date(s.DischargedAt)<span class="hint-text" style="display:block;">@s.FinalDiagnosis</span></span>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                }
            </div>
        }

        @if (active && canManage)
        {
            <button type="button" class="btn btn-ghost btn-sm" style="align-self:flex-start; color:var(--bad);" onclick="document.getElementById('cancelDialog').showModal()"><i class="bi bi-x-circle"></i> Səhvən yerləşdirilib — ləğv et</button>
        }
    </div>
</div>

@if (active && canManage)
{
    <dialog id="moveDialog" class="modal">
        <form asp-action="Move" method="post">
            <input type="hidden" name="id" value="@a.Id" />
            <h3 style="margin:0 0 8px;">Çarpayını dəyiş</h3>
            <p class="hint-text" style="margin:0 0 14px;">İndiki: @a.Bed?.Label. Yataq-gün yeni palatanın qiyməti ilə davam edir.</p>
            <div class="field">
                <label for="bedId">Yeni çarpayı</label>
                <select id="bedId" name="bedId" class="form-select" required>
                    @foreach (var g in Model.FreeBeds.GroupBy(b => b.Ward.Department?.Name ?? "Şöbəsiz"))
                    {
                        <optgroup label="@g.Key">@foreach (var b in g) { <option value="@b.Id">@b.Ward.Name · çarpayı @b.Name</option> }</optgroup>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(!Model.FreeBeds.Any())">Köçür</button>
                <button type="button" class="btn btn-light" onclick="this.closest('dialog').close()">Bağla</button>
            </div>
        </form>
    </dialog>
    <dialog id="cancelDialog" class="modal">
        <form asp-action="Cancel" method="post">
            <input type="hidden" name="id" value="@a.Id" />
            <h3 style="margin:0 0 8px;">@a.Number ləğv edilsin?</h3>
            <p class="hint-text" style="margin:0 0 14px;">Yalnız səhv yerləşdirmə üçün: qeyd və təyinat yazılıbsa, ləğv mümkün deyil — xəstəni çıxarış ilə çıxarın.</p>
            <div class="field"><label for="reason">Səbəb</label><input id="reason" name="reason" class="form-control" maxlength="300" required autocomplete="off" /></div>
            <div class="form-actions">
                <button type="submit" class="btn btn-danger-solid">Ləğv et</button>
                <button type="button" class="btn btn-light" onclick="this.closest('dialog').close()">Bağla</button>
            </div>
        </form>
    </dialog>
}

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('orderForm');
            if (!form) return;
            const item = document.getElementById('StockItemId'), nameField = document.getElementById('drugNameField'),
                qtyField = document.getElementById('qtyField'), unit = document.getElementById('qtyUnit'),
                sched = document.getElementById('sched'), custom = document.getElementById('timesCustom'), times = document.getElementById('Times');
            function sync() {
                const o = item.selectedOptions[0];
                const fromStock = !!item.value;
                nameField.hidden = fromStock;
                qtyField.hidden = !fromStock;
                unit.textContent = fromStock && o.dataset.unit ? '(' + o.dataset.unit + ')' : '';
                custom.hidden = sched.value !== 'custom';
                times.value = sched.value === 'custom' ? custom.value : sched.value;
            }
            [item, sched].forEach(el => el.addEventListener('change', sync));
            custom.addEventListener('input', sync);
            form.addEventListener('submit', sync);
            sync();
        })();
    </script>
}
