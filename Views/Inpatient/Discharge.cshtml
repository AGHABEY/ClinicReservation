@model DischargeInput
@{
    var a = (Admission)ViewBag.Admission;
    ViewData["Title"] = "Çıxarış";
    var (_, days, _) = InpatientService.BedDays(a, DateTime.Now);
}

<div class="page-head">
    <div>
        <h2>Çıxarış və epikriz</h2>
        <p>@a.Patient.FullName · @a.Number · @Fmt.Date(a.AdmittedAt) – bu gün (@days yataq-gün)</p>
    </div>
    <a class="btn btn-light" asp-action="Details" asp-route-id="@a.Id"><i class="bi bi-arrow-left"></i> Xəstəlik tarixi</a>
</div>

<div class="card" style="max-width:900px;">
    <div class="card-pad">
        <form asp-action="Discharge" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="AdmissionId" />
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Outcome">Nəticə</label>
                    <select asp-for="Outcome" class="form-select">
                        <option value="">— seçin —</option>
                        @foreach (var o in Enum.GetValues<DischargeOutcome>()) { <option value="@o">@InpatientLabels.Outcome(o)</option> }
                    </select>
                    <span asp-validation-for="Outcome" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="IcdCode">Yekun BXT-10 kodu</label>
                    <input asp-for="IcdCode" class="form-control" list="icdList" maxlength="10" autocomplete="off" style="text-transform:uppercase;" />
                    <span asp-validation-for="IcdCode" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Diagnosis">Yekun diaqnoz</label>
                    <input asp-for="Diagnosis" class="form-control" list="icdNames" maxlength="300" autocomplete="off" />
                    <span asp-validation-for="Diagnosis" class="text-danger"></span>
                </div>
            </div>
            <datalist id="icdList">@foreach (var c in IcdCatalog.Common) { <option value="@c.Value">@c.Name</option> }</datalist>
            <datalist id="icdNames">@foreach (var c in IcdCatalog.Common) { <option value="@c.Name">@c.Value</option> }</datalist>
            <div class="field mt-3">
                <label asp-for="Course">Xəstəliyin gedişi</label>
                <textarea asp-for="Course" class="form-control" rows="5" maxlength="4000" placeholder="Daxil olarkən vəziyyəti, müayinələrin nəticələri, dinamika …"></textarea>
                <span asp-validation-for="Course" class="text-danger"></span>
            </div>
            <div class="field mt-3">
                <label asp-for="Treatment">Aparılmış müalicə <span class="hint-text">(təyinat vərəqindən dolduruldu — düzəldə bilərsiniz)</span></label>
                <textarea asp-for="Treatment" class="form-control" rows="5" maxlength="4000"></textarea>
                <span asp-validation-for="Treatment" class="text-danger"></span>
            </div>
            <div class="field mt-3">
                <label asp-for="Recommendations">Tövsiyələr</label>
                <textarea asp-for="Recommendations" class="form-control" rows="4" maxlength="4000" placeholder="Rejim, pəhriz, dərmanlar, təkrar müayinə …"></textarea>
                <span asp-validation-for="Recommendations" class="text-danger"></span>
            </div>
            <p class="hint-text" style="margin-top:14px;"><i class="bi bi-info-circle"></i> Çıxarışdan sonra çarpayı boşalır, aktiv təyinatlar dayanır və epikriz çapa hazır olur. Xəstəlik tarixi yalnız oxunur.</p>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-box-arrow-right"></i> Çıxar və epikrizi yarat</button>
                <a class="btn btn-light" asp-action="Details" asp-route-id="@a.Id">İmtina</a>
            </div>
        </form>
    </div>
</div>
