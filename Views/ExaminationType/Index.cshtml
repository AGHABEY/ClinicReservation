@model List<ExaminationType>
@{
    ViewData["Title"] = "Müayinələr";
}

<div class="page-head">
    <div>
        <h2>Müayinə növləri</h2>
        <p>Klinikada təklif olunan müayinələr (@Model.Count)</p>
    </div>
    <a class="btn btn-primary" asp-action="Add"><i class="bi bi-plus-lg"></i> Yeni müayinə</a>
</div>

@if (Model.Any())
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Təsvir</th>
                    <th>Qiymət</th>
                    <th style="text-align:right;">Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-weight:600;"><i class="bi bi-clipboard2-pulse text-muted"></i> @item.Name</td>
                        <td class="text-muted">@(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)</td>
                        <td><span style="font-weight:600; color:var(--brand-dark);">@item.Price ₼</span></td>
                        <td style="text-align:right;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> Düzəliş
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-clipboard2-x"></i>
            <p>Hələ müayinə növü əlavə edilməyib</p>
            <a class="btn btn-primary mt-3" asp-action="Add"><i class="bi bi-plus-lg"></i> İlk müayinəni əlavə et</a>
        </div>
    </div>
}
