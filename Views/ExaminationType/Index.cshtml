@model List<ExaminationType>
@{
    ViewData["Title"] = "Müayinələr";
}

<div class="page-head">
    <div>
        <h2>Müayinə növləri</h2>
        <p>Klinikada təklif olunan müayinələr (@Model.Count)</p>
    </div>
    @if (User.Can(Permissions.CatalogManage))
    {
        <a class="btn btn-primary" asp-action="Add"><i class="bi bi-plus-lg"></i> Yeni müayinə</a>
    }
</div>

@if (Model.Any())
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Şöbə</th>
                    <th>Təsvir</th>
                    <th class="num">Qiymət</th>
                    <th class="actions">Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-weight:600;"><i class="bi bi-clipboard2-pulse text-muted"></i> @item.Name
                            @if (item.LabTests.Any()) { <div class="test-chips" style="margin-top:4px;">@foreach (var l in item.LabTests.OrderBy(l => l.LabTest.SortOrder)) { <span class="test-chip">@l.LabTest.Code</span> }</div> }
                            @if (item.Materials.Any()) { <div class="hint-text" style="font-weight:400; margin-top:4px;" title="@string.Join(", ", item.Materials.Select(m => $"{m.StockItem.DisplayName} × {StockService.Qty(m.Quantity)}"))"><i class="bi bi-box-seam"></i> @item.Materials.Count material</div> }
                        </td>
                        <td class="text-muted">@(item.Department?.Name ?? "Ümumi")</td>
                        <td class="text-muted wrap">@(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)</td>
                        <td class="num money">@Fmt.Money(item.Price)</td>
                        <td class="actions">
                            @if (User.Can(Permissions.CatalogManage))
                            {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-ghost btn-sm">
                                <i class="bi bi-pencil"></i> Düzəliş
                            </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-clipboard2-x"></i>
            <p>Hələ müayinə növü əlavə edilməyib</p>
            <a class="btn btn-primary mt-3" asp-action="Add"><i class="bi bi-plus-lg"></i> İlk müayinəni əlavə et</a>
        </div>
    </div>
}
