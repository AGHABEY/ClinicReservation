@model ExaminationType
@{
    ViewData["Title"] = "Müayinəyə düzəliş";
}

<div class="page-head">
    <div>
        <h2>Müayinəyə düzəliş</h2>
        <p>@Model.Name</p>
    </div>
    <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Siyahıya qayıt</a>
</div>

<div class="card" style="max-width:720px;">
    <div class="card-pad">
        <form asp-action="Edit" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Name">Ad</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Price">Qiymət (₼)</label>
                    <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" inputmode="decimal" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="DepartmentId">Şöbə</label>
                    <select asp-for="DepartmentId" class="form-select" asp-items="@(new SelectList((List<Department>)ViewBag.Departments, "Id", "Name"))">
                        <option value="">— Ümumi —</option>
                    </select>
                </div>
            </div>
            <div class="field mt-3">
                <label asp-for="Description">Təsvir</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <p class="hint-text" style="margin-top:14px;"><i class="bi bi-info-circle"></i> Qiymət dəyişikliyi yalnız yeni rezervasiyalara tətbiq olunur — mövcud rezervasiyaların məbləği dəyişmir.</p>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Yadda saxla</button>
                <a class="btn btn-light" asp-action="Index">İmtina</a>
            </div>
        </form>
    </div>
</div>
