@model AccountViewModel
@{
    ViewData["Title"] = "Yeni istifadəçi";
}

<div class="page-head">
    <div>
        <h2>Yeni istifadəçi</h2>
        <p>İstifadəçi adı və şifrə təyin edin</p>
    </div>
    <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Siyahıya qayıt</a>
</div>

<div class="card" style="max-width:560px;">
    <div class="card-pad">
        <form asp-controller="Account" asp-action="CreateUser" method="post">
            <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>
            <div class="field">
                <label asp-for="UserName">İstifadəçi adı</label>
                <input class="form-control" asp-for="UserName" placeholder="istifadeci" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="field mt-3">
                <label asp-for="Password">Şifrə</label>
                <input class="form-control" type="password" asp-for="Password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mt-3" style="display:flex; gap:10px;">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Yarat</button>
                <a class="btn btn-light" asp-action="Index">İmtina</a>
            </div>
        </form>
    </div>
</div>
