@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifrəni sıfırla";
}

<div class="page-head">
    <div>
        <h2>Şifrəni sıfırla</h2>
        <p>@Model.UserName üçün yeni şifrə təyin edin</p>
    </div>
    <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Siyahıya qayıt</a>
</div>

<div class="card" style="max-width:560px;">
    <div class="card-pad">
        <form asp-action="ResetPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="field">
                <label asp-for="NewPassword">Yeni şifrə</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
                <span class="hint-text">Ən azı 6 simvol</span>
            </div>
            <div class="field mt-3">
                <label asp-for="ConfirmPassword">Yeni şifrə (təkrar)</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <p class="hint-text" style="margin-top:14px;"><i class="bi bi-info-circle"></i> İstifadəçinin açıq sessiyaları bağlanacaq və o, yeni şifrə ilə daxil olmalı olacaq. Hesab bloklanıbsa, blok da açılır.</p>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-key"></i> Şifrəni təyin et</button>
                <a class="btn btn-light" asp-action="Index">İmtina</a>
            </div>
        </form>
    </div>
</div>
