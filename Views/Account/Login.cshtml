@model AccountViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Giriş · MedClinic</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230d9488'/%3E%3Cpath d='M6 17h5l2-5 4 10 3-7h6' fill='none' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <style>
        body {
            display: grid;
            place-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #0d9488 0%, #0f766e 45%, #115e59 100%);
            padding: 20px;
        }
        .login-card {
            display: grid;
            grid-template-columns: 1fr 1fr;
            max-width: 880px;
            width: 100%;
            background: #fff;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 30px 70px rgba(0,0,0,.3);
        }
        .login-aside {
            background: linear-gradient(135deg, #14b8a6, #0d9488);
            color: #fff;
            padding: 48px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .login-aside .big-icon { font-size: 3.5rem; margin-bottom: 18px; }
        .login-aside h2 { font-size: 1.7rem; font-weight: 700; margin: 0 0 12px; }
        .login-aside p { opacity: .9; line-height: 1.6; font-size: .95rem; }
        .login-aside ul { list-style: none; padding: 0; margin: 26px 0 0; }
        .login-aside li { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; font-size: .92rem; }
        .login-aside li i { background: rgba(255,255,255,.2); width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; }
        .login-body { padding: 48px 44px; }
        .login-body .field + .field { margin-top: 14px; }
        @@media (max-width: 480px) { .login-body { padding: 32px 22px; } }
        .login-body h1 { font-size: 1.6rem; font-weight: 700; margin: 0 0 6px; }
        .login-body .sub { color: var(--muted); font-size: .92rem; margin-bottom: 28px; }
        .input-icon { position: relative; }
        .input-icon i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; }
        .input-icon .form-control { padding-left: 42px; }
        .hint { background: var(--brand-soft); border: 1px dashed var(--brand-light); color: var(--brand-dark); padding: 11px 14px; border-radius: 11px; font-size: .82rem; margin-top: 20px; text-align: center; }
        @@media (max-width: 760px) { .login-card { grid-template-columns: 1fr; } .login-aside { display: none; } }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-aside">
            <div class="big-icon"><i class="bi bi-heart-pulse-fill"></i></div>
            <h2>MedClinic</h2>
            <p>Klinika rezervasiya və müayinə idarəetmə sistemi. Növbələri, müayinələri və istifadəçiləri bir paneldən idarə edin.</p>
            <ul>
                <li><i class="bi bi-calendar2-check"></i> Rezervasiyaların idarəsi</li>
                <li><i class="bi bi-clipboard2-pulse"></i> Müayinə növləri və qiymətlər</li>
                <li><i class="bi bi-shield-lock"></i> Təhlükəsiz giriş</li>
            </ul>
        </div>
        <div class="login-body">
            <h1>Xoş gəlmisiniz 👋</h1>
            <p class="sub">Davam etmək üçün hesabınıza daxil olun</p>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="field">
                    <label asp-for="UserName">İstifadəçi adı</label>
                    <div class="input-icon">
                        <i class="bi bi-person"></i>
                        <input class="form-control" asp-for="UserName" placeholder="İstifadəçi adı" autocomplete="username" autofocus>
                    </div>
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Password">Şifrə</label>
                    <div class="input-icon">
                        <i class="bi bi-lock"></i>
                        <input type="password" class="form-control" asp-for="Password" placeholder="••••••••" autocomplete="current-password">
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-3" style="justify-content:center;">
                    <i class="bi bi-box-arrow-in-right"></i> Daxil ol
                </button>
            </form>

            @if (Env.IsDevelopment())
            {
                <div class="hint">
                    <i class="bi bi-info-circle"></i> Demo: <strong>admin</strong> / <strong>admin123</strong>
                </div>
            }
        </div>
    </div>
</body>
</html>
