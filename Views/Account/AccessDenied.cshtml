@{
    ViewData["Title"] = "İcazə yoxdur";
}

<div class="card" style="max-width:560px; margin:40px auto;">
    <div class="card-pad" style="text-align:center; padding:48px 32px;">
        <div style="width:72px; height:72px; border-radius:20px; background:#fee2e2; color:#b91c1c; display:grid; place-items:center; margin:0 auto 20px; font-size:2rem;">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h2 style="margin:0 0 8px; font-size:1.4rem; font-weight:700;">İcazəniz yoxdur</h2>
        <p class="text-muted" style="margin:0 0 24px;">Bu bölməyə giriş üçün lazımi rol təyin edilməyib. Administratorla əlaqə saxlayın.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> İdarə panelinə qayıt</a>
    </div>
</div>
