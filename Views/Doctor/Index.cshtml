@model List<Doctor>
@{
    ViewData["Title"] = "Həkimlər";
    var todayCounts = (Dictionary<int, int>)ViewBag.TodayCounts;
    var today = DateTime.Today;
    var canEdit = User.Can(Permissions.CatalogManage);
}

<div class="page-head">
    <div>
        <h2>Həkimlər</h2>
        <p>@Model.Count(d => d.IsActive) aktiv həkim</p>
    </div>
    @if (canEdit)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> Yeni həkim</a>
    }
</div>

@if (Model.Any())
{
    <div class="doctor-grid">
        @foreach (var d in Model)
        {
            var hoursToday = d.WorkHours.FirstOrDefault(w => w.Day == today.DayOfWeek);
            var onLeave = d.Leaves.FirstOrDefault(l => l.From <= today && l.To >= today);
            var count = todayCounts.TryGetValue(d.Id, out var c) ? c : 0;
            <div class="card doctor-card @(d.IsActive ? "" : "inactive")">
                <div style="display:flex; gap:14px; align-items:center;">
                    <span class="avatar-lg">@Fmt.Initials(d.FullName)</span>
                    <div style="min-width:0;">
                        <div style="font-weight:700; font-size:1.02rem;">@d.FullName</div>
                        <div class="hint-text">@(d.Specialty ?? "—")@(d.Department == null ? "" : $" · {d.Department.Name}")</div>
                    </div>
                </div>
                <div class="doctor-meta">
                    <span><i class="bi bi-door-closed"></i> @(d.Room?.Name ?? "Kabinet yoxdur")</span>
                    <span><i class="bi bi-stopwatch"></i> @d.SlotMinutes dəq</span>
                </div>
                <div class="week-strip" aria-label="İş günləri">
                    @foreach (var day in ClinicReservation.Controllers.DoctorController.Week)
                    {
                        var w = d.WorkHours.FirstOrDefault(x => x.Day == day);
                        <span class="@(w != null ? "on" : "")" title="@Fmt.DayName(day)@(w != null ? $": {w.Start:hh\\:mm}–{w.End:hh\\:mm}" : ": işləmir")">@Fmt.DayShortName(day)</span>
                    }
                </div>
                <div class="doctor-today">
                    @if (!d.IsActive)
                    {
                        <span class="badge-soft badge-default">Deaktiv</span>
                    }
                    else if (onLeave != null)
                    {
                        <span class="badge-soft badge-noshow">Məzuniyyətdə · @Fmt.Date(onLeave.To)-dək</span>
                    }
                    else if (hoursToday == null)
                    {
                        <span class="badge-soft badge-default">Bu gün işləmir</span>
                    }
                    else
                    {
                        <span class="badge-soft badge-confirmed">Bu gün @hoursToday.Start.ToString(@"hh\:mm")–@hoursToday.End.ToString(@"hh\:mm")</span>
                    }
                    <a class="hint-text" asp-controller="Reservation" asp-action="Index" asp-route-period="today" asp-route-doctorId="@d.Id">@count qəbul bu gün</a>
                </div>
                <div class="page-actions">
                    @if (d.IsActive && User.Can(Permissions.ReservationsManage))
                    {
                        <a class="btn btn-ghost btn-sm" asp-controller="Reservation" asp-action="Add" asp-route-doctorId="@d.Id"><i class="bi bi-calendar-plus"></i> Yaz</a>
                    }
                    @if (canEdit)
                    {
                        <a class="btn btn-light btn-sm" asp-action="Edit" asp-route-id="@d.Id"><i class="bi bi-pencil"></i> Qrafik və məlumat</a>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-person-badge"></i>
            <p>Hələ həkim əlavə edilməyib. Rezervasiya üçün ən azı bir həkim və onun iş qrafiki lazımdır.</p>
            @if (canEdit)
            {
                <a class="btn btn-primary mt-3" asp-action="Create"><i class="bi bi-person-plus"></i> İlk həkimi əlavə et</a>
            }
        </div>
    </div>
}
