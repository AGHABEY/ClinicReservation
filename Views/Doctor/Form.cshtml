@model DoctorFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Həkim" : "Yeni həkim";
    var departments = (List<Department>)ViewBag.Departments;
    var rooms = (List<Room>)ViewBag.Rooms;
    var users = (List<AppUser>)ViewBag.Users;
    var leaves = (List<DoctorLeave>)ViewBag.Leaves;
}

<div class="page-head">
    <div>
        <h2>@(Model.IsEdit ? Model.FullName : "Yeni həkim")</h2>
        <p>Məlumatlar, həftəlik iş qrafiki və məzuniyyətlər</p>
    </div>
    <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Həkimlər</a>
</div>

<form asp-action="Save" method="post" novalidate>
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="detail-grid">
        <div class="card">
            <div class="card-pad">
                <h3 class="card-title"><i class="bi bi-calendar-week"></i> Həftəlik iş qrafiki</h3>
                <div class="table-scroll">
                    <table class="data compact schedule">
                        <thead><tr><th>Gün</th><th>İşləyir</th><th>Başlanğıc</th><th>Son</th><th>Fasilə</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Days.Count; i++)
                            {
                                <tr>
                                    <td style="font-weight:600;">@Fmt.DayName(Model.Days[i].Day)<input type="hidden" asp-for="Days[i].Day" /></td>
                                    <td><label class="switch"><input type="checkbox" asp-for="Days[i].Works" class="day-toggle" /><span></span></label></td>
                                    <td><input asp-for="Days[i].Start" type="time" class="form-control day-field" step="300" /></td>
                                    <td><input asp-for="Days[i].End" type="time" class="form-control day-field" step="300" /></td>
                                    <td>
                                        <div style="display:flex; gap:6px; align-items:center;">
                                            <input asp-for="Days[i].BreakStart" type="time" class="form-control day-field" step="300" aria-label="Fasilə başlanğıcı" />
                                            <span class="hint-text">–</span>
                                            <input asp-for="Days[i].BreakEnd" type="time" class="form-control day-field" step="300" aria-label="Fasilə sonu" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="hint-text" style="margin:12px 0 0;"><i class="bi bi-info-circle"></i> Fasilə istəyə bağlıdır. Qrafik dəyişikliyi mövcud rezervasiyalara toxunmur, yalnız yeni boş saatları dəyişir.</p>
            </div>
        </div>

        <div class="card">
            <div class="card-pad">
                <h3 class="card-title"><i class="bi bi-person-badge"></i> Məlumatlar</h3>
                <div class="stack" style="gap:14px;">
                    <div class="field">
                        <label asp-for="FullName">Ad və soyad</label>
                        <input asp-for="FullName" class="form-control" placeholder="Dr. Leyla Məmmədova" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Specialty">İxtisas</label>
                        <input asp-for="Specialty" class="form-control" placeholder="Kardioloq" />
                    </div>
                    <div class="field">
                        <label asp-for="DepartmentId">Şöbə</label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="@(new SelectList(departments, "Id", "Name"))">
                            <option value="">— Şöbəsiz —</option>
                        </select>
                    </div>
                    <div class="field">
                        <label asp-for="RoomId">Kabinet</label>
                        <select asp-for="RoomId" class="form-select" asp-items="@(new SelectList(rooms, "Id", "Name"))">
                            <option value="">— Kabinet yoxdur —</option>
                        </select>
                        <span class="hint-text">Eyni kabinetdə iki həkimin qəbulu üst-üstə düşə bilməz</span>
                    </div>
                    <div class="field">
                        <label asp-for="SlotMinutes">Bir qəbulun müddəti (dəq)</label>
                        <input asp-for="SlotMinutes" type="number" min="5" max="240" step="5" class="form-control" />
                        <span asp-validation-for="SlotMinutes" class="text-danger"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Phone">Telefon</label>
                        <input asp-for="Phone" type="tel" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="field">
                        <label asp-for="UserId">Sistem istifadəçisi</label>
                        <select asp-for="UserId" class="form-select" asp-items="@(new SelectList(users, "Id", "UserName"))">
                            <option value="">— Bağlı deyil —</option>
                        </select>
                        <span class="hint-text">Bağlansa, həkim daxil olanda yalnız öz qəbullarını görür</span>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>
                    <label style="display:flex; gap:10px; align-items:center; font-weight:600;">
                        <input asp-for="IsActive" type="checkbox" /> Aktiv (yeni rezervasiya qəbul edir)
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Yadda saxla</button>
        <a class="btn btn-light" asp-action="Index">İmtina</a>
    </div>
</form>

@if (Model.IsEdit)
{
    <div class="card mt-3">
        <div class="card-head">
            <h3 class="card-title"><i class="bi bi-airplane"></i> Məzuniyyət və istirahət günləri</h3>
        </div>
        <div class="card-pad">
            <form asp-action="AddLeave" method="post" class="filter-bar">
                <input type="hidden" name="DoctorId" value="@Model.Id" />
                <div class="field" style="margin:0;"><label for="lf">Başlanğıc</label><input id="lf" name="From" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                <div class="field" style="margin:0;"><label for="lt">Son</label><input id="lt" name="To" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                <div class="field" style="margin:0; flex:1; min-width:200px;"><label for="lr">Səbəb</label><input id="lr" name="Reason" class="form-control" maxlength="100" placeholder="Məzuniyyət, konfrans..." /></div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Əlavə et</button>
            </form>
            @if (leaves.Any())
            {
                <div class="line-list mt-3">
                    @foreach (var l in leaves)
                    {
                        <div class="line-item">
                            <span><strong>@Fmt.Date(l.From) – @Fmt.Date(l.To)</strong> <span class="hint-text">@l.Reason</span></span>
                            <form asp-action="DeleteLeave" asp-route-id="@l.Id" method="post" data-confirm="Bu məzuniyyət silinsin?">
                                <button type="submit" class="btn btn-danger btn-sm" aria-label="Sil"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="hint-text" style="margin:14px 0 0;">Planlaşdırılmış məzuniyyət yoxdur.</p>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        // Grey out the time fields of days the doctor doesn't work.
        document.querySelectorAll('.day-toggle').forEach(t => {
            const row = t.closest('tr');
            const sync = () => row.querySelectorAll('.day-field').forEach(f => { f.disabled = !t.checked; });
            t.addEventListener('change', sync);
            sync();
        });
        // Disabled inputs aren't posted; re-enable them right before submit so values are kept.
        document.querySelector('form[action*="Save"]')?.addEventListener('submit', e => {
            e.target.querySelectorAll('.day-field').forEach(f => { f.disabled = false; });
        });
    </script>
}
