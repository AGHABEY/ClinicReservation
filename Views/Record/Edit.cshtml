@model RecordFormViewModel
@{
    var r = Model.Reserve!;
    var p = r.Patient;
    ViewData["Title"] = $"Tibbi qeyd — {p.FullName}";
    var status = r.Status?.Name;
    var canFinish = status is StatusNames.Arrived or StatusNames.InProgress;
}

<div class="page-head">
    <div style="display:flex; align-items:center; gap:16px;">
        <span class="avatar-lg">@Fmt.Initials(p.FullName)</span>
        <div>
            <h2>@p.FullName</h2>
            <p>@Fmt.Age(p.Birthday) yaş · FİN @p.PinCode · @Fmt.Appointment(r.AppointmentAt) · <partial name="_StatusBadge" model="status" /></p>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" asp-controller="Workspace" asp-action="Index" asp-route-doctorId="@r.DoctorId"><i class="bi bi-arrow-left"></i> İş masası</a>
        <a class="btn btn-light" asp-controller="Patient" asp-action="Details" asp-route-id="@p.Id"><i class="bi bi-person-vcard"></i> Xəstə kartı</a>
        @if (Model.Exists && r.MedicalRecord != null)
        {
            <a class="btn btn-light" asp-action="Print" asp-route-id="@r.MedicalRecord.Id" target="_blank" rel="noopener"><i class="bi bi-printer"></i> Çap</a>
        }
    </div>
</div>

<form asp-action="Edit" method="post" novalidate id="recordForm">
    <input type="hidden" asp-for="ReserveId" />
    <input type="hidden" asp-for="Finish" value="" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="record-grid">
        <div class="card card-pad">
            <div class="record-section">
                <h4>Şikayət və anamnez</h4>
                <div class="field">
                    <label asp-for="Complaint">Şikayətlər</label>
                    <textarea asp-for="Complaint" class="form-control" rows="3" maxlength="4000" placeholder="Xəstə nədən şikayət edir, nə vaxtdan"></textarea>
                    <span asp-validation-for="Complaint" class="text-danger"></span>
                </div>
                <div class="field mt-3">
                    <label asp-for="Anamnesis">Anamnez</label>
                    <textarea asp-for="Anamnesis" class="form-control" rows="3" maxlength="4000" placeholder="Xəstəliyin gedişi, keçirilmiş xəstəliklər, qəbul etdiyi dərmanlar"></textarea>
                    <span asp-validation-for="Anamnesis" class="text-danger"></span>
                </div>
            </div>

            <div class="record-section">
                <h4>Müayinə və diaqnoz</h4>
                <div class="field">
                    <label asp-for="Examination">Obyektiv müayinə</label>
                    <textarea asp-for="Examination" class="form-control" rows="3" maxlength="4000" placeholder="AT, nəbz, temperatur, müayinə nəticələri"></textarea>
                    <span asp-validation-for="Examination" class="text-danger"></span>
                </div>
                <div class="icd-row mt-3">
                    <div class="field">
                        <label asp-for="IcdCode">BXT-10 kodu</label>
                        <input asp-for="IcdCode" class="form-control" list="icdList" maxlength="10" autocomplete="off" placeholder="J06.9" style="text-transform:uppercase;" />
                        <span asp-validation-for="IcdCode" class="text-danger"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Diagnosis">Diaqnoz</label>
                        <input asp-for="Diagnosis" class="form-control" list="icdNames" maxlength="300" autocomplete="off" placeholder="Kodu və ya diaqnozu yazmağa başlayın" />
                        <span asp-validation-for="Diagnosis" class="text-danger"></span>
                    </div>
                </div>
                <span class="hint-text">Siyahıda geniş yayılmış kodlar var; istənilən başqa kodu əl ilə yaza bilərsiniz.</span>
                <datalist id="icdList">
                    @foreach (var c in IcdCatalog.Common) { <option value="@c.Value">@c.Name</option> }
                </datalist>
                <datalist id="icdNames">
                    @foreach (var c in IcdCatalog.Common) { <option value="@c.Name">@c.Value</option> }
                </datalist>
            </div>

            <div class="record-section">
                <h4>Müalicə</h4>
                <div class="field">
                    <label asp-for="Treatment">Müalicə planı</label>
                    <textarea asp-for="Treatment" class="form-control" rows="3" maxlength="4000"></textarea>
                    <span asp-validation-for="Treatment" class="text-danger"></span>
                </div>
                <div class="field mt-3">
                    <label asp-for="Prescription">Resept <span class="hint-text">(hər dərman ayrı sətirdə)</span></label>
                    <textarea asp-for="Prescription" class="form-control" rows="4" maxlength="4000" placeholder="Məs: Paracetamol 500 mq — gündə 3 dəfə, 5 gün"></textarea>
                    <span asp-validation-for="Prescription" class="text-danger"></span>
                </div>
                <div class="field mt-3">
                    <label asp-for="Recommendations">Tövsiyələr</label>
                    <textarea asp-for="Recommendations" class="form-control" rows="2" maxlength="4000"></textarea>
                    <span asp-validation-for="Recommendations" class="text-danger"></span>
                </div>
                <div class="field mt-3" style="max-width:260px;">
                    <label asp-for="FollowUpDays">Kontrol qəbulu <span class="hint-text">(neçə gün sonra)</span></label>
                    <input asp-for="FollowUpDays" type="number" min="1" max="365" class="form-control" placeholder="məs: 14" />
                    <span asp-validation-for="FollowUpDays" class="text-danger"></span>
                </div>
            </div>

            <div class="record-actions">
                @if (Model.Exists && r.MedicalRecord?.UpdatedAt != null)
                {
                    <span class="hint-text" style="margin-right:auto; align-self:center;">Son dəyişiklik: @Fmt.DateTime(r.MedicalRecord.UpdatedAt) · @r.MedicalRecord.UpdatedBy</span>
                }
                <button type="submit" class="btn btn-light"><i class="bi bi-save"></i> Yadda saxla</button>
                @if (canFinish)
                {
                    <button type="submit" class="btn btn-primary" onclick="this.form.Finish.value='1'"><i class="bi bi-check2-all"></i> Saxla və qəbulu bitir</button>
                }
            </div>
        </div>

        <div class="stack">
            <div class="card card-pad">
                <h3 class="card-title"><i class="bi bi-exclamation-octagon"></i> Xəbərdarlıqlar</h3>
                <div class="field">
                    <label asp-for="Allergies">Allergiyalar</label>
                    <textarea asp-for="Allergies" class="form-control" rows="2" maxlength="500" placeholder="Məs: penisillin, qoz"></textarea>
                    <span asp-validation-for="Allergies" class="text-danger"></span>
                </div>
                <div class="field mt-3">
                    <label asp-for="ChronicConditions">Xroniki xəstəliklər</label>
                    <textarea asp-for="ChronicConditions" class="form-control" rows="2" maxlength="500" placeholder="Məs: 2-ci tip diabet, hipertenziya"></textarea>
                    <span asp-validation-for="ChronicConditions" class="text-danger"></span>
                </div>
                <span class="hint-text">Xəstənin kartında saxlanılır və bütün həkimlərə qırmızı xəbərdarlıq kimi görünür.</span>
            </div>

            <div class="card card-pad">
                <h3 class="card-title"><i class="bi bi-clipboard2-pulse"></i> Bu vizit</h3>
                <dl class="detail-list">
                    <div class="detail-row"><dt>Həkim</dt><dd>@(r.Doctor?.FullName ?? "—")</dd></div>
                    <div class="detail-row"><dt>Müayinə</dt><dd>@string.Join(", ", r.ReserveExaminationTypes!.Select(x => x.ExaminationType.Name))</dd></div>
                    @if (r.ArrivedAt != null)
                    {
                        <div class="detail-row"><dt>Gəldi</dt><dd>@Fmt.Time(r.ArrivedAt.Value)</dd></div>
                    }
                </dl>
                @if (!string.IsNullOrEmpty(p.Notes))
                {
                    <div class="alert alert-warning" style="margin:12px 0 0;"><i class="bi bi-sticky"></i> @p.Notes</div>
                }
            </div>

            <div class="card card-pad">
                <h3 class="card-title"><i class="bi bi-clock-history"></i> Əvvəlki qeydlər</h3>
                @if (Model.History.Any())
                {
                    @foreach (var h in Model.History)
                    {
                        <a class="history-item" asp-action="Show" asp-route-id="@h.Id" target="_blank" rel="noopener">
                            <div class="d">@Fmt.Date(h.CreatedAt) · @(h.Doctor?.FullName ?? "—")</div>
                            <div class="t">@if (h.IcdCode != null) {<span class="icd">@h.IcdCode</span>}@(h.Diagnosis ?? "Diaqnoz yazılmayıb")</div>
                        </a>
                    }
                }
                else
                {
                    <p class="hint-text" style="margin:0;">Bu xəstənin əvvəlki tibbi qeydi yoxdur.</p>
                }
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            // Picking a code fills the diagnosis and vice versa.
            const codes = new Map([...document.querySelectorAll('#icdList option')].map(o => [o.value.toUpperCase(), o.textContent]));
            const names = new Map([...document.querySelectorAll('#icdNames option')].map(o => [o.value, o.textContent]));
            const code = document.getElementById('IcdCode'), diag = document.getElementById('Diagnosis');
            code.addEventListener('change', () => {
                const name = codes.get(code.value.trim().toUpperCase());
                if (name && (!diag.value || names.has(diag.value))) diag.value = name;
            });
            diag.addEventListener('change', () => {
                const c = names.get(diag.value);
                if (c && !code.value) code.value = c;
            });

            // Warn before leaving with unsaved changes.
            const form = document.getElementById('recordForm');
            let dirty = false;
            form.addEventListener('input', () => { dirty = true; });
            form.addEventListener('submit', () => { dirty = false; });
            window.addEventListener('beforeunload', (e) => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
        })();
    </script>
}
