@model List<AuditLog>
@{
    ViewData["Title"] = "Audit jurnalı";
    var entities = (List<string>)ViewBag.Entities;
    var entity = ViewBag.Entity as string;
    var entityId = ViewBag.EntityId as string;
    var q = ViewBag.Query as string;
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
    var pageNo = (int)ViewBag.Page;
    var total = (int)ViewBag.Total;
    var size = (int)ViewBag.PageSize;
    var pages = Math.Max(1, (int)Math.Ceiling(total / (double)size));
}

<div class="page-head">
    <div>
        <h2>Audit jurnalı</h2>
        <p>Kim, nə vaxt, nə etdi — @total qeyd@(string.IsNullOrEmpty(entityId) ? "" : $" · {entity} #{entityId}")</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-pad">
        <form method="get" class="filter-bar">
            <div class="field" style="margin:0;">
                <label for="ae">Bölmə</label>
                <select id="ae" name="entity" class="form-select">
                    <option value="">Hamısı</option>
                    @foreach (var e in entities)
                    {
                        <option value="@e" selected="@(e == entity)">@e</option>
                    }
                </select>
            </div>
            <div class="field" style="margin:0;"><label for="af">Başlanğıc</label><input id="af" type="date" name="from" value="@from?.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="field" style="margin:0;"><label for="at">Son</label><input id="at" type="date" name="to" value="@to?.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="field" style="margin:0; flex:1; min-width:200px;"><label for="aq">Axtarış</label><input id="aq" name="q" value="@q" class="form-control" placeholder="İstifadəçi, əməliyyat və ya xəstə adı" /></div>
            @if (!string.IsNullOrEmpty(entityId))
            {
                <input type="hidden" name="entityId" value="@entityId" />
            }
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Filtrlə</button>
            <a class="btn btn-light" asp-action="Index">Təmizlə</a>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="table-wrap">
        <table class="data">
            <thead><tr><th>Vaxt</th><th>İstifadəçi</th><th>Əməliyyat</th><th>Obyekt</th><th>Təfərrüat</th><th>IP</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="text-muted">@Fmt.DateTime(a.At)</td>
                        <td style="font-weight:600;">@(a.UserName ?? "—")</td>
                        <td>@a.Action</td>
                        <td>
                            @if (a.EntityType == AuditEntities.Reservation && int.TryParse(a.EntityId, out var rid))
                            {
                                <a asp-controller="Reservation" asp-action="Details" asp-route-id="@rid">@a.EntityType #@a.EntityId</a>
                            }
                            else if (a.EntityType == AuditEntities.Patient && int.TryParse(a.EntityId, out var pid))
                            {
                                <a asp-controller="Patient" asp-action="Details" asp-route-id="@pid">@a.EntityType #@a.EntityId</a>
                            }
                            else
                            {
                                <span class="text-muted">@a.EntityType@(a.EntityId == null ? "" : $" · {a.EntityId}")</span>
                            }
                        </td>
                        <td class="text-muted wrap" style="max-width:420px;">@a.Details</td>
                        <td class="hint-text">@a.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (pages > 1)
    {
        <div class="pager">
            <span class="hint-text">Səhifə @pageNo / @pages</span>
            <div class="page-actions">
                <a class="btn btn-light btn-sm" asp-action="Index" asp-route-entity="@entity" asp-route-entityId="@entityId" asp-route-q="@q" asp-route-from="@from?.ToString("yyyy-MM-dd")" asp-route-to="@to?.ToString("yyyy-MM-dd")" asp-route-page="@(pageNo - 1)" aria-disabled="@(pageNo <= 1 ? "true" : null)">Əvvəlki</a>
                <a class="btn btn-light btn-sm" asp-action="Index" asp-route-entity="@entity" asp-route-entityId="@entityId" asp-route-q="@q" asp-route-from="@from?.ToString("yyyy-MM-dd")" asp-route-to="@to?.ToString("yyyy-MM-dd")" asp-route-page="@(pageNo + 1)" aria-disabled="@(pageNo >= pages ? "true" : null)">Növbəti</a>
            </div>
        </div>
    }
}
else
{
    <div class="card"><div class="empty-state"><i class="bi bi-journal-x"></i><p>Bu filtrə uyğun qeyd yoxdur</p></div></div>
}
