@model List<Supplier>
@{
    ViewData["Title"] = "Təchizatçılar";
}

<div class="page-head">
    <div>
        <h2>Aptek və anbar</h2>
        <p>Dərman və material təchizatçıları — mədaxil sənədində seçilir</p>
    </div>
</div>

<partial name="_StockNav" />

<div class="card" style="max-width:1100px;">
    <div class="table-scroll">
        <table class="data">
            <thead><tr><th>Ad</th><th>VÖEN</th><th>Telefon</th><th>Qeyd</th><th>Aktiv</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Model.Append(new Supplier()))
                {
                    var isNew = s.Id == 0;
                    var formId = isNew ? "supNew" : $"sup{s.Id}";
                    <tr class="@(s.IsActive ? "" : "row-muted")">
                        <td><input form="@formId" name="name" value="@s.Name" class="form-control" maxlength="200" placeholder="@(isNew ? "Yeni təchizatçı" : "")" aria-label="Ad" /></td>
                        <td><input form="@formId" name="voen" value="@s.Voen" class="form-control" maxlength="10" inputmode="numeric" style="max-width:130px;" aria-label="VÖEN" /></td>
                        <td><input form="@formId" name="phone" value="@s.Phone" class="form-control" maxlength="32" style="max-width:160px;" aria-label="Telefon" /></td>
                        <td><input form="@formId" name="note" value="@s.Note" class="form-control" maxlength="500" aria-label="Qeyd" /></td>
                        <td><input form="@formId" type="checkbox" name="isActive" value="true" checked="@s.IsActive" aria-label="Aktiv" /><input form="@formId" type="hidden" name="isActive" value="false" /></td>
                        <td class="actions">
                            <form id="@formId" asp-action="SaveSupplier" method="post"><input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn @(isNew ? "btn-primary" : "btn-ghost") btn-sm">@if (isNew) { <i class="bi bi-plus-lg"></i> <span>Əlavə et</span> } else { <span>Yadda saxla</span> }</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
