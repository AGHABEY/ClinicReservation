@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => controller == c ? "active" : "";
    var userName = User.Identity?.Name ?? "User";
    var initial = string.IsNullOrEmpty(userName) ? "U" : userName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · MedClinic</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="logo"><i class="bi bi-heart-pulse-fill"></i></span>
                <span>MedClinic<small>Reservation</small></span>
            </a>

            <div class="nav-section">Ümumi</div>
            <ul class="sidebar-nav">
                <li>
                    <a class="@Active("Home")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> İdarə paneli
                    </a>
                </li>
                <li>
                    <a class="@Active("Kassa")" asp-controller="Kassa" asp-action="Index">
                        <i class="bi bi-cash-coin"></i> Kassa
                    </a>
                </li>
                <li>
                    <a class="@Active("Report")" asp-controller="Report" asp-action="Index">
                        <i class="bi bi-bar-chart-line-fill"></i> Hesabatlar
                    </a>
                </li>
            </ul>

            <div class="nav-section">İdarəetmə</div>
            <ul class="sidebar-nav">
                <li>
                    <a class="@Active("Reservation")" asp-controller="Reservation" asp-action="Index">
                        <i class="bi bi-calendar2-check-fill"></i> Rezervasiyalar
                    </a>
                </li>
                <li>
                    <a class="@Active("ExaminationType")" asp-controller="ExaminationType" asp-action="Index">
                        <i class="bi bi-clipboard2-pulse-fill"></i> Müayinələr
                    </a>
                </li>
                <li>
                    <a class="@Active("Account")" asp-controller="Account" asp-action="Index">
                        <i class="bi bi-people-fill"></i> İstifadəçilər
                    </a>
                </li>
            </ul>
        </aside>
        <div class="backdrop" id="backdrop"></div>

        <!-- Main -->
        <div class="main">
            <header class="topbar">
                <div style="display:flex; align-items:center; gap:14px;">
                    <button class="menu-toggle" id="menuToggle"><i class="bi bi-list"></i></button>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="dropdown">
                    <div class="user-chip" id="userChip" style="cursor:pointer;">
                        <span class="avatar">@initial</span>
                        <span>@userName</span>
                        <i class="bi bi-chevron-down" style="font-size:.75rem; color:var(--muted);"></i>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" style="display:none;">
                        @Html.AntiForgeryToken()
                    </form>
                    <div id="userMenu" style="display:none; position:absolute; right:0; margin-top:8px; background:#fff; border:1px solid var(--line); border-radius:12px; box-shadow:var(--shadow); min-width:170px; overflow:hidden; z-index:1050;">
                        <a href="javascript:document.getElementById('logoutForm').submit();" style="display:flex; align-items:center; gap:10px; padding:12px 16px; color:#b91c1c; text-decoration:none; font-size:.9rem; font-weight:500;">
                            <i class="bi bi-box-arrow-right"></i> Çıxış
                        </a>
                    </div>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        // Mobile sidebar
        const sb = document.getElementById('sidebar');
        const bd = document.getElementById('backdrop');
        document.getElementById('menuToggle')?.addEventListener('click', () => {
            sb.classList.toggle('open'); bd.classList.toggle('show');
        });
        bd?.addEventListener('click', () => { sb.classList.remove('open'); bd.classList.remove('show'); });

        // User menu
        const chip = document.getElementById('userChip');
        const menu = document.getElementById('userMenu');
        chip?.addEventListener('click', (e) => { e.stopPropagation(); menu.style.display = menu.style.display === 'none' ? 'block' : 'none'; });
        document.addEventListener('click', () => { if (menu) menu.style.display = 'none'; });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
