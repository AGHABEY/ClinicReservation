@model ErrorViewModel
@{
    var notFound = Model.StatusCode == 404;
    ViewData["Title"] = notFound ? "Tapılmadı" : "Xəta";
}

<div class="card status-page">
    <div class="status-icon @(notFound ? "muted" : "danger")">
        <i class="bi @(notFound ? "bi-search" : "bi-exclamation-triangle-fill")"></i>
    </div>
    @if (notFound)
    {
        <h2>Səhifə tapılmadı</h2>
        <p class="text-muted">Axtardığınız səhifə və ya qeyd mövcud deyil, ya da silinib.</p>
    }
    else
    {
        <h2>Xəta baş verdi</h2>
        <p class="text-muted">Sorğunuz emal edilərkən gözlənilməz xəta baş verdi. Bir az sonra yenidən cəhd edin.</p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> İdarə panelinə qayıt</a>
    @if (Model.ShowRequestId && !notFound)
    {
        <p style="margin:20px 0 0;"><code>Sorğu ID: @Model.RequestId</code></p>
    }
</div>
