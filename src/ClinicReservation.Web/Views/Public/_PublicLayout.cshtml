<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230E7C74'/%3E%3Cpath d='M6 17h5l2-5 4 10 3-7h6' fill='none' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <title>@ViewData["Title"] · MedClinic</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <style>
        body { background: var(--bg); }
        .pub { max-width: 460px; margin: 0 auto; padding: 24px 16px 48px; }
        .pub-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; margin-bottom: 20px; }
        .pub-brand .logo { width: 34px; height: 34px; border-radius: 9px; background: var(--brand); color: #fff; display: grid; place-items: center; }
        .pub-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 20px; }
        .pub-hello { margin: 0 0 16px; font-size: 16px; font-weight: 600; }
        .pub-appt { padding: 18px; border-radius: var(--radius-sm); background: var(--brand-tint); border: 1px solid var(--brand-ring); }
        .pub-appt.closed { background: var(--surface-2); border-color: var(--line); }
        .pub-appt.closed .pub-time, .pub-appt.closed .pub-hour { text-decoration: line-through; color: var(--subtle); }
        .pub-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--brand-dark); }
        .pub-time { font-size: 18px; font-weight: 700; margin-top: 6px; }
        .pub-hour { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; }
        .pub-doc { margin-top: 8px; color: var(--ink-2); }
        .pub-doc i { color: var(--brand); margin-right: 4px; }
        .pub-status { margin-top: 12px; font-size: 13px; color: var(--muted); }
        .pub-actions { display: grid; gap: 10px; margin-top: 20px; }
        .pub-actions .btn, .pub-cancel .btn { width: 100%; height: 48px; font-size: 15px; }
        .pub-cancel { margin-top: 12px; padding: 14px; border-radius: var(--radius-sm); background: var(--bad-bg); }
        .pub-cancel p { margin: 0 0 12px; color: var(--bad); font-size: 14px; }
        .pub-result { display: flex; gap: 10px; align-items: center; padding: 12px 14px; border-radius: var(--radius-sm); margin-bottom: 16px; font-weight: 600; }
        .pub-result.ok { background: var(--ok-bg); color: var(--ok); }
        .pub-result.bad { background: var(--bad-bg); color: var(--bad); }
        .pub-note { margin: 18px 0 0; color: var(--muted); font-size: 14px; }
        .pub-foot { text-align: center; margin-top: 20px; font-size: 12px; color: var(--subtle); }
        .pub.wide { max-width: 720px; }
        .pub-steps { display: flex; gap: 6px; margin-bottom: 14px; font-size: 12px; color: var(--subtle); }
        .pub-steps span.on { color: var(--brand-dark); font-weight: 700; }
        .pub-list { display: grid; gap: 10px; }
        .pub-pick { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--ink); text-decoration: none; }
        .pub-pick:hover { border-color: var(--brand); }
        .pub-pick small { display: block; color: var(--muted); font-weight: 400; }
        .pub-group { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 14px 0 6px; }
        .stars { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 4px; }
        .stars input { position: absolute; opacity: 0; pointer-events: none; }
        .stars label { font-size: 34px; color: var(--line); cursor: pointer; line-height: 1; }
        .stars input:checked ~ label, .stars label:hover, .stars label:hover ~ label { color: #F5B700; }
        .stars input:focus-visible + label { outline: 3px solid var(--brand-ring); border-radius: 4px; }
    </style>
</head>
<body>
    <div class="pub @(ViewData["Wide"] is true ? "wide" : "")">
        <div class="pub-brand"><span class="logo"><i class="bi bi-heart-pulse-fill"></i></span> MedClinic</div>
        @RenderBody()
        <div class="pub-foot">@(ViewData["Foot"] as string ?? "Bu səhifə yalnız sizin üçündür — linki başqası ilə paylaşmayın.")</div>
    </div>
</body>
</html>
