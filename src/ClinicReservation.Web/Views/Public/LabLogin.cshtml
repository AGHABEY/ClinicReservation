@model Reserve
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Analiz nəticələri";
    var error = ViewBag.Error as string;
}

<div class="pub-card">
    <p class="pub-hello">Hörmətli @Model.Patient.Name,</p>
    <p class="pub-note" style="margin:0 0 16px;">Analiz nəticələrinizə baxmaq üçün doğum tarixinizi daxil edin.</p>
    @if (error != null)
    {
        <div class="pub-result bad"><i class="bi bi-exclamation-circle-fill"></i> @error</div>
    }
    <form method="post" action="/r/@ViewBag.Token/lab">
        @Html.AntiForgeryToken()
        <div class="field">
            <label for="birthday">Doğum tarixi</label>
            <input id="birthday" name="birthday" type="date" class="form-control" required max="@ClinicTime.Today.ToString("yyyy-MM-dd")" style="height:48px; font-size:16px;" />
        </div>
        <div class="pub-actions">
            <button type="submit" class="btn btn-primary"><i class="bi bi-unlock"></i> Nəticələri göstər</button>
        </div>
    </form>
</div>
