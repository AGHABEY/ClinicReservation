@model DeskTicket
@{
    Layout = null;
    var ahead = (int)ViewBag.Ahead;
    var kiosk = ViewBag.Kiosk as bool? ?? false;
    var back = ViewBag.Back as string;
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Talon @Model.Ticket</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; font-family: 'Inter', -apple-system, sans-serif; }
        body { margin: 0; background: #F4F5F7; color: #101828; }
        .ticket { width: 80mm; margin: 24px auto; padding: 18px 16px; background: #fff; text-align: center; border: 1px dashed #D0D5DD; }
        .brand { font-weight: 800; font-size: 15px; }
        .sub { font-size: 12px; color: #475467; margin-top: 2px; }
        .num { font-size: 56px; font-weight: 800; letter-spacing: -0.02em; margin: 14px 0 6px; font-variant-numeric: tabular-nums; }
        .row { display: flex; justify-content: space-between; font-size: 13px; padding: 5px 0; border-top: 1px solid #F2F4F7; }
        .row span:first-child { color: #475467; }
        .row span:last-child { font-weight: 600; }
        .note { font-size: 11px; color: #475467; margin-top: 12px; }
        .tools { text-align: center; margin: 0 0 24px; }
        .tools button, .tools a { font: 600 14px Inter, sans-serif; height: 40px; padding: 0 16px; border-radius: 10px; border: 1px solid #D0D5DD; background: #fff; color: #101828; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; }
        .tools button { background: #0E7C74; border-color: #0E7C74; color: #fff; }
        @@media print { @@page { size: 80mm auto; margin: 0; } body { background: #fff; } .ticket { margin: 0; border: 0; } .tools { display: none; } }
    </style>
</head>
<body>
    <div class="ticket">
        <div class="brand">MedClinic</div>
        <div class="sub">@QueueLabels.Desk(Model.Kind) növbəsi</div>
        <div class="num">@Model.Ticket</div>
        @if (Model.Priority != QueuePriority.None) { <div class="sub" style="font-weight:700; color:#B42318;">Prioritet: @QueueLabels.Priority(Model.Priority)</div> }
        <div class="row"><span>Qarşınızda</span><span>@ahead nəfər</span></div>
        <div class="row"><span>Verilib</span><span>@Fmt.DateTime(Model.IssuedAt)</span></div>
        <div class="note">Nömrəniz ekranda göründükdə göstərilən pəncərəyə yaxınlaşın.</div>
    </div>
    <div class="tools">
        <button type="button" onclick="window.print()">Çap et</button>
        <a href="@(kiosk ? Url.Action("Index", "Kiosk") : back ?? Url.Action("Index", "Desk"))">@(kiosk ? "Başa qayıt" : "Geri")</a>
    </div>
    <script>
        window.addEventListener('load', () => window.print());
        @if (kiosk) { <text>setTimeout(() => location.href = '@Url.Action("Index", "Kiosk")', 10000);</text> }
    </script>
</body>
</html>
