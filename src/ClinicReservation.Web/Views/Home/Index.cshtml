@model DashboardViewModel
@{
    ViewData["Title"] = "İdarə paneli";
    var showMoney = User.Can(Permissions.KassaTotals);
    var now = ClinicTime.Now;
    var nextId = Model.TodayAppointments
        .FirstOrDefault(r => r.Status?.Name is StatusNames.Waiting or StatusNames.Confirmed && r.AppointmentAt >= now.AddMinutes(-15))?.Id;
    ViewData["ReturnTo"] = "home";
    ViewData["PrimaryOnly"] = true;
    var next = Model.TodayAppointments.FirstOrDefault(r => r.Id == nextId)
        ?? Model.TodayAppointments.FirstOrDefault(r => r.Status?.Name is StatusNames.Arrived);
}

<div class="page-head">
    <div>
        <h2>Xoş gəlmisiniz, @User.Identity?.Name</h2>
        <p>@(Model.MyDoctor != null ? $"{Model.MyDoctor.FullName} — bugünkü qəbullarınız" : "Klinikanın bugünkü vəziyyəti")</p>
    </div>
</div>

<div class="stat-grid">
    <a class="stat stat-link" asp-controller="Reservation" asp-action="Index" asp-route-period="today">
        <div class="icon teal"><i class="bi bi-calendar2-event"></i></div>
        <div>
            <div class="value">@Model.TodayCount</div>
            <div class="label">Bu günkü qəbul</div>
        </div>
    </a>
    <a class="stat stat-link" asp-controller="Reservation" asp-action="Index" asp-route-period="today" asp-route-status="@StatusNames.Arrived">
        <div class="icon blue"><i class="bi bi-hourglass-split"></i></div>
        <div>
            <div class="value">@Model.WaitingRoomCount</div>
            <div class="label">Gözləmə zalında</div>
        </div>
    </a>
    <div class="stat">
        <div class="icon violet"><i class="bi bi-activity"></i></div>
        <div>
            <div class="value">@Model.InProgressCount</div>
            <div class="label">Hazırda qəbulda</div>
        </div>
    </div>
    <div class="stat">
        <div class="icon green"><i class="bi bi-check2-all"></i></div>
        <div>
            <div class="value">@Model.CompletedToday</div>
            <div class="label">Bu gün tamamlandı</div>
        </div>
    </div>
</div>

<div class="stat-grid">
    <a class="stat stat-link" asp-controller="Reservation" asp-action="Index" asp-route-status="@StatusNames.Waiting">
        <div class="icon amber"><i class="bi bi-clock"></i></div>
        <div>
            <div class="value">@Model.WaitingReservations</div>
            <div class="label">Təsdiq gözləyən</div>
        </div>
    </a>
    <a class="stat stat-link" asp-controller="Reservation" asp-action="Index" asp-route-period="tomorrow">
        <div class="icon teal"><i class="bi bi-calendar-plus"></i></div>
        <div>
            <div class="value">@Model.TomorrowCount</div>
            <div class="label">Sabahkı qəbul</div>
        </div>
    </a>
    @if (showMoney)
    {
        <div class="stat">
            <div class="icon green"><i class="bi bi-wallet2"></i></div>
            <div>
                <div class="value">@Fmt.Money(Model.TodayIncome)</div>
                <div class="label">Bu gün kassa</div>
            </div>
        </div>
        <a class="stat stat-link" asp-controller="Kassa" asp-action="Index" asp-route-filter="unpaid">
            <div class="icon red"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <div class="value">@Fmt.Money(Model.Outstanding)</div>
                <div class="label">Qalıq borc</div>
            </div>
        </a>
    }
</div>

<div class="detail-grid dash-grid">
<div class="card">
    <div class="card-head">
        <h3 class="card-title"><i class="bi bi-calendar2-event"></i> Bu günün qəbulları</h3>
        <a class="btn btn-light btn-sm" asp-controller="Reservation" asp-action="Index" asp-route-period="today">Hamısı <i class="bi bi-arrow-right"></i></a>
    </div>
    @if (Model.TodayAppointments.Any())
    {
        <div class="table-scroll">
            <table class="data dash-table">
                <thead>
                    <tr><th>Saat</th><th>Xəstə</th><th>Müayinələr</th><th>Status</th><th class="actions">Əməliyyat</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.TodayAppointments)
                    {
                        var done = r.Status?.Name == StatusNames.Completed;
                        <tr class="@(r.Id == nextId ? "row-next" : done ? "row-muted" : "")">
                            <td>
                                <span class="time-pill" title="@(r.Id == nextId ? "Növbəti qəbul" : null)">@Fmt.Time(r.AppointmentAt)</span>
                            </td>
                            <td>
                                <a asp-controller="Reservation" asp-action="Details" asp-route-id="@r.Id" class="link-strong">@r.Patient.FullName</a>
                                <div class="hint-text">@(Model.MyDoctor == null ? (r.Doctor?.FullName ?? "Həkim təyin edilməyib") : r.Patient.Phone)</div>
                            </td>
                            <td class="text-muted wrap">@string.Join(", ", r.ReserveExaminationTypes!.Select(x => x.ExaminationType.Name))</td>
                            <td><partial name="_StatusBadge" model="r.Status?.Name" /></td>
                            <td class="actions"><div class="actions-inner"><partial name="_StatusActions" model="r" /></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-calendar2-check"></i>
            <p>Bu gün üçün qəbul yoxdur</p>
        </div>
    }
</div>

<div class="stack">
    @if (next != null)
    {
        <div class="card card-pad next-card">
            <div class="flex-between">
                <span class="next-label">Növbəti qəbul</span>
                <partial name="_StatusBadge" model="next.Status?.Name" />
            </div>
            <div style="display:flex; align-items:center; gap:14px; margin-top:16px;">
                <span class="avatar-lg">@Fmt.Initials(next.Patient.FullName)</span>
                <div style="min-width:0;">
                    <div style="font-size:18px; font-weight:700;">@next.Patient.FullName</div>
                    <div class="hint-text">@Fmt.Age(next.Patient.Birthday) yaş · @next.Patient.Phone</div>
                </div>
            </div>
            <div class="next-facts">
                <div><span>Vaxt</span><strong>@Fmt.Appointment(next.AppointmentAt)</strong></div>
                <div><span>Həkim</span><strong>@(next.Doctor?.FullName ?? "—")</strong></div>
                <div style="grid-column: span 2;"><span>Müayinə</span><strong>@string.Join(", ", next.ReserveExaminationTypes!.Select(x => x.ExaminationType.Name))</strong></div>
            </div>
            <div class="page-actions" style="margin-top:16px;">
                @if (User.CanAny(Permissions.PaymentsTake, Permissions.KassaTotals))
                {
                    <a class="btn btn-primary" style="flex:1;" asp-controller="Kassa" asp-action="Pay" asp-route-id="@next.Id">Ödəniş</a>
                }
                <a class="btn btn-light" style="flex:1;" asp-controller="Reservation" asp-action="Details" asp-route-id="@next.Id">Detallar</a>
            </div>
        </div>
    }
    else
    {
        <div class="card card-pad">
            <span class="next-label">Növbəti qəbul</span>
            <p class="hint-text" style="margin:10px 0 0;">Bu gün üçün gözlənilən başqa qəbul yoxdur.</p>
        </div>
    }

    @if (Model.MyDoctor != null && User.Can(Permissions.QueueCall))
    {
        <a class="card card-pad quick-link" asp-controller="Workspace" asp-action="Index" style="display:flex; align-items:center; gap:14px;">
            <span class="ticket" style="min-width:44px;"><i class="bi bi-clipboard2-heart"></i></span>
            <span style="flex:1;"><strong style="display:block;">İş masasını aç</strong><span class="hint-text">@Model.WaitingRoomCount xəstə növbədə gözləyir</span></span>
            <i class="bi bi-chevron-right"></i>
        </a>
    }

    @if (Model.MyDoctor == null && User.Can(Permissions.CatalogManage))
    {
        <div class="card card-pad">
            <h3 class="card-title"><i class="bi bi-lightning-charge"></i> Tez keçidlər</h3>
            <div class="line-list">
                <a class="line-item quick-link" asp-controller="Patient" asp-action="Index"><span><i class="bi bi-person-vcard"></i> Xəstələr</span><i class="bi bi-chevron-right"></i></a>
                <a class="line-item quick-link" asp-controller="Doctor" asp-action="Index"><span><i class="bi bi-person-badge"></i> Həkimlər və qrafiklər</span><i class="bi bi-chevron-right"></i></a>
                <a class="line-item quick-link" asp-controller="Kassa" asp-action="Index" asp-route-filter="unpaid"><span><i class="bi bi-wallet2"></i> Borclu ödənişlər</span><i class="bi bi-chevron-right"></i></a>
            </div>
        </div>
    }
</div>
</div>
