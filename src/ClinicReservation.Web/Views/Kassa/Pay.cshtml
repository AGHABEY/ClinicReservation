@model PaymentViewModel
@{
    ViewData["Title"] = "Ödəniş";
    var isAdmin = User.Can(Permissions.PaymentsRefund);
    var cancelled = StatusNames.IsClosedWithoutVisit(Model.Reserve?.Status?.Name);
    var needsRefund = Model.Balance < 0;
    var pct = Model.Total > 0 ? (int)Math.Clamp(Model.Paid / Model.Total * 100, 0, 100) : (Model.Paid > 0 ? 100 : 0);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="page-head">
    <div>
        <h2>Ödəniş — @Model.Reserve?.Patient.FullName</h2>
        <p>Rezervasiya #@Model.ReserveId · @Fmt.Appointment(Model.Reserve!.AppointmentAt) · <partial name="_StatusBadge" model="Model.Reserve.Status?.Name" /></p>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Kassa</a>
        <a class="btn btn-light" asp-controller="Reservation" asp-action="Details" asp-route-id="@Model.ReserveId"><i class="bi bi-person-vcard"></i> Rezervasiya</a>
    </div>
</div>

<div class="report-grid">
    <div class="stack">
        <div class="card">
            <div class="card-pad">
                <div class="summary-grid">
                    <div>
                        <div class="label">Ödənilməli</div>
                        <div class="value">@Fmt.Money(Model.Total)</div>
                    </div>
                    <div>
                        <div class="label">Ödənilib</div>
                        <div class="value money pos">@Fmt.Money(Model.Paid)</div>
                    </div>
                    <div>
                        <div class="label">@(needsRefund ? "Qaytarılmalı" : "Qalıq")</div>
                        <div class="value money @(Model.Balance != 0 ? "neg" : "")">@Fmt.Money(Math.Abs(Model.Balance))</div>
                    </div>
                </div>
                <div class="progress-track" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="Ödəniş faizi">
                    <div class="progress-fill" style="width:@pct%"></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-pad">
                @if (needsRefund)
                {
                    <h3 class="card-title"><i class="bi bi-arrow-counterclockwise"></i> Geri qaytarma</h3>
                    @if (isAdmin)
                    {
                        <p class="text-muted" style="font-size:.9rem; margin-top:0;">
                            @(cancelled ? $"Rezervasiya «{StatusNames.Label(Model.Reserve.Status?.Name)}» statusundadır." : "Xəstə ödənilməli məbləğdən çox ödəyib.")
                            Xəstəyə qaytardığınız məbləği qeyd edin.
                        </p>
                        <form asp-action="Refund" method="post" novalidate data-confirm="Geri qaytarma qeydə alınsın?">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            <input type="hidden" asp-for="ReserveId" />
                            <div class="form-grid">
                                <div class="field">
                                    <label asp-for="Amount">Qaytarılan məbləğ (₼)</label>
                                    <input asp-for="Amount" type="number" step="0.01" min="0.01" max="@((-Model.Balance).ToString(inv))"
                                           value="@Model.Amount.ToString("0.00", inv)" class="form-control" inputmode="decimal" />
                                    <span asp-validation-for="Amount" class="text-danger"></span>
                                    <span class="hint-text">Maksimum: @Fmt.Money(-Model.Balance)</span>
                                </div>
                                <div class="field">
                                    <label asp-for="Method">Üsul</label>
                                    <select asp-for="Method" class="form-select">
                                        <option value="@((int)PaymentMethod.Cash)">Nağd</option>
                                        <option value="@((int)PaymentMethod.Card)">Kart</option>
                                        <option value="@((int)PaymentMethod.Points)">Bonus bal</option>
                                    </select>
                                </div>
                            </div>
                            <div class="field mt-3">
                                <label asp-for="Note">Qeyd</label>
                                <input asp-for="Note" class="form-control" placeholder="Məs: ləğv səbəbilə qaytarıldı" maxlength="250" />
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn btn-danger-solid"><i class="bi bi-arrow-counterclockwise"></i> Qaytarmanı qeyd et</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning" style="margin-bottom:0;"><i class="bi bi-exclamation-triangle"></i> Xəstəyə @Fmt.Money(-Model.Balance) qaytarılmalıdır. Geri qaytarmanı səlahiyyətli işçi (kassir və ya administrator) qeyd edir.</div>
                    }
                }
                else if (cancelled)
                {
                    <h3 class="card-title"><i class="bi bi-x-circle"></i> Rezervasiya «@StatusNames.Label(Model.Reserve.Status?.Name)»</h3>
                    <p class="text-muted" style="margin:0;">Bu rezervasiyaya ödəniş qəbul edilmir.</p>
                }
                else if (Model.Balance <= 0)
                {
                    <h3 class="card-title"><i class="bi bi-cash-coin"></i> Yeni ödəniş</h3>
                    <div class="alert alert-success" style="margin-bottom:0;"><i class="bi bi-check-circle"></i> Bu rezervasiya tam ödənilib.</div>
                }
                else
                {
                    <h3 class="card-title"><i class="bi bi-cash-coin"></i> Yeni ödəniş</h3>
                    <form asp-action="Pay" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="ReserveId" />
                        <div class="form-grid">
                            <div class="field">
                                <label asp-for="Amount">Məbləğ (₼)</label>
                                <input asp-for="Amount" type="number" step="0.01" min="0.01" max="@Model.Balance.ToString(inv)"
                                       value="@Model.Amount.ToString("0.00", inv)" class="form-control" inputmode="decimal" />
                                <span asp-validation-for="Amount" class="text-danger"></span>
                                <span class="hint-text">Maksimum: @Fmt.Money(Model.Balance)</span>
                            </div>
                            <div class="field">
                                <label asp-for="Method">Ödəniş üsulu</label>
                                <select asp-for="Method" class="form-select">
                                    <option value="@((int)PaymentMethod.Cash)">Nağd</option>
                                    <option value="@((int)PaymentMethod.Card)">Kart</option>
                                    @if (Model.HasCard)
                                    {
                                        <option value="@((int)PaymentMethod.Points)">Bonus bal (@Model.Points bal ≈ @Fmt.Money(Model.PointsMoney))</option>
                                    }
                                </select>
                                <span asp-validation-for="Method" class="text-danger"></span>
                                @if (Model.HasCard)
                                {
                                    <span class="hint-text">Kartda @Model.Points bal; ən azı @Model.MinPoints bal istifadə olunur.</span>
                                }
                            </div>
                        </div>
                        <div class="field mt-3">
                            <label asp-for="Note">Qeyd</label>
                            <input asp-for="Note" class="form-control" placeholder="İstəyə bağlı" maxlength="250" />
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Ödənişi qeyd et</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="stack">
        <div class="card">
            <div class="card-pad">
                <h3 class="card-title"><i class="bi bi-clipboard2-pulse"></i> Müayinələr</h3>
                @if (Model.Reserve.ReserveExaminationTypes != null && Model.Reserve.ReserveExaminationTypes.Any())
                {
                    <div class="line-list">
                        @foreach (var ex in Model.Reserve.ReserveExaminationTypes)
                        {
                            <div class="line-item">
                                <span>@ex.ExaminationType.Name</span>
                                <span class="money" style="@(cancelled ? "text-decoration:line-through; color:var(--muted);" : "")">@Fmt.Money(ex.Price)</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted" style="font-size:.9rem;">Müayinə yoxdur.</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-pad">
                <h3 class="card-title"><i class="bi bi-clock-history"></i> Ödəniş tarixçəsi</h3>
                @if (Model.Payments.Any())
                {
                    <div class="table-scroll">
                        <table class="data compact">
                            <tbody>
                                @foreach (var p in Model.Payments)
                                {
                                    var refund = p.Amount < 0;
                                    <tr>
                                        <td class="wrap">
                                            <div class="money @(refund ? "neg" : "")">@(refund ? "−" : "")@Fmt.Money(Math.Abs(p.Amount))</div>
                                            <div class="text-muted" style="font-size:.78rem;">@Fmt.DateTime(p.PaidAt)@(string.IsNullOrEmpty(p.Note) ? "" : " · " + p.Note)</div>
                                        </td>
                                        <td class="actions">
                                            @if (refund)
                                            {
                                                <span class="badge-soft badge-refund">Qaytarma</span>
                                            }
                                            <span class="badge-soft @(p.Method switch { PaymentMethod.Cash => "badge-cash", PaymentMethod.Points => "badge-partial", _ => "badge-card" })">
                                                @(p.Method switch { PaymentMethod.Cash => "Nağd", PaymentMethod.Points => "Bonus bal", _ => "Kart" })
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted" style="font-size:.9rem;">Hələ ödəniş edilməyib.</p>
                }
            </div>
        </div>
    </div>
</div>
