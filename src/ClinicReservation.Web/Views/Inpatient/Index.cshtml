@model InpatientBoardViewModel
@{
    ViewData["Title"] = "Stasionar";
    var now = ClinicTime.Now;
    var total = Model.Beds.Count;
    var busy = Model.Beds.Count(b => b.Stay != null);
    var manage = User.Can(Permissions.InpatientManage);
}

<div class="page-head">
    <div>
        <h2>Stasionar</h2>
        <p>Palatalar, çarpayılar və yatan xəstələr — boş çarpayıya klikləyib xəstəni yerləşdirin</p>
    </div>
    <div class="page-actions">
        @if (manage)
        {
            <a class="btn btn-primary" asp-action="Admit"><i class="bi bi-plus-lg"></i> Yerləşdir</a>
        }
    </div>
</div>

<partial name="_InpatientNav" />

<div class="stat-grid">
    <div class="stat">
        <div class="icon violet"><i class="bi bi-hospital"></i></div>
        <div><div class="value">@busy <span style="font-size:15px; color:var(--subtle); font-weight:500;">/ @total</span></div><div class="label">Dolu çarpayı</div></div>
    </div>
    <div class="stat">
        <div class="icon green"><i class="bi bi-door-open"></i></div>
        <div><div class="value">@(total - busy)</div><div class="label">Boş çarpayı</div></div>
    </div>
    <div class="stat">
        <div class="icon teal"><i class="bi bi-pie-chart"></i></div>
        <div><div class="value">@(total == 0 ? 0 : (int)Math.Round(100.0 * busy / total))%</div><div class="label">Doluluq</div></div>
    </div>
    <div class="stat">
        <div class="icon blue"><i class="bi bi-arrow-left-right"></i></div>
        <div><div class="value">@Model.AdmittedToday <span style="font-size:15px; color:var(--subtle); font-weight:500;">/ @Model.DischargedToday</span></div><div class="label">Bu gün daxil olan / çıxan</div></div>
    </div>
</div>

@if (Model.Departments.Count > 1)
{
    <div class="toolbar">
        <div class="seg seg-scroll">
            <a class="@(Model.DepartmentId == null ? "on" : "")" asp-action="Index">Bütün şöbələr</a>
            @foreach (var d in Model.Departments)
            {
                <a class="@(Model.DepartmentId == d.Id ? "on" : "")" asp-action="Index" asp-route-departmentId="@d.Id">@d.Name</a>
            }
        </div>
    </div>
}

@if (!Model.Beds.Any())
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-hospital"></i>
            <p>Hələ palata yoxdur</p>
            @if (manage)
            {
                <p class="hint-text" style="margin-top:6px;"><a asp-controller="Ward" asp-action="Index">Palatalar</a> səhifəsində palataları və çarpayıları yaradın.</p>
            }
        </div>
    </div>
}

@foreach (var dept in Model.Beds.GroupBy(b => b.Bed.Ward.Department?.Name ?? "Şöbəsiz"))
{
    <h3 class="board-dept">@dept.Key</h3>
    <div class="ward-grid">
        @foreach (var ward in dept.GroupBy(b => b.Bed.Ward))
        {
            var w = ward.Key;
            <div class="card ward-card">
                <div class="ward-head">
                    <span class="ward-name">@w.Name</span>
                    @if (w.Gender != WardGender.Mixed) { <span class="badge-soft @(w.Gender == WardGender.Male ? "badge-arrived" : "badge-inprogress")">@InpatientLabels.Gender(w.Gender)</span> }
                    <span class="hint-text" style="margin-left:auto;">@ward.Count(b => b.Stay != null) / @ward.Count()</span>
                </div>
                <div class="bed-grid">
                    @foreach (var (bed, stay) in ward)
                    {
                        if (stay == null)
                        {
                            if (manage)
                            {
                                <a class="bed free" asp-action="Admit" asp-route-bedId="@bed.Id" aria-label="@w.Name, çarpayı @bed.Name — boş, yerləşdir">
                                    <span class="bed-no">@bed.Name</span><span class="bed-free"><i class="bi bi-plus-lg"></i> Boş</span>
                                </a>
                            }
                            else
                            {
                                <div class="bed free"><span class="bed-no">@bed.Name</span><span class="bed-free">Boş</span></div>
                            }
                        }
                        else
                        {
                            var p = stay.Patient;
                            <a class="bed busy @(stay.Type == AdmissionType.Emergency ? "emergency" : "")" asp-action="Details" asp-route-id="@stay.Id">
                                <span class="bed-no">@bed.Name</span>
                                <span class="bed-name">@p.FullName @if (!string.IsNullOrWhiteSpace(p.Allergies)) { <i class="bi bi-exclamation-octagon-fill med-flag" title="Allergiya: @p.Allergies"></i> }</span>
                                <span class="bed-meta">@Fmt.Age(p.Birthday) yaş · @(p.Gender == null ? "" : Fmt.Gender(p.Gender) + " · ")@Fmt.Ordinal(stay.Day(now)) gün</span>
                                <span class="bed-meta">@(stay.AdmitDiagnosis ?? "")</span>
                                @if (stay.Doctor != null) { <span class="bed-doc"><i class="bi bi-person-badge"></i> @stay.Doctor.FullName</span> }
                            </a>
                        }
                    }
                </div>
            </div>
        }
    </div>
}
