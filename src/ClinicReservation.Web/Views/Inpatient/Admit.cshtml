@model AdmitViewModel
@{
    ViewData["Title"] = "Stasionara yerləşdirmə";
    var p = Model.Patient;
}

<div class="page-head">
    <div>
        <h2>Stasionara yerləşdirmə</h2>
        <p>Xəstəni boş çarpayıya yerləşdirin və daxilolma diaqnozunu yazın</p>
    </div>
    <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Çarpayı xəritəsi</a>
</div>

<div class="card" style="max-width:860px;">
    <div class="card-pad">
        <form asp-action="Admit" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="ReserveId" />
            @if (p != null)
            {
                <input type="hidden" asp-for="PatientId" />
                <div class="patient-found" style="margin-bottom:16px;">
                    <i class="bi bi-person-check-fill"></i>
                    <span><strong>@p.FullName</strong> · @p.PinCode · @Fmt.Age(p.Birthday) yaş@(p.Gender != null ? " · " + Fmt.Gender(p.Gender) : "")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(p.Allergies))
                {
                    <div class="med-alert" style="margin-bottom:16px;"><i class="bi bi-exclamation-octagon-fill"></i><span><strong>Allergiya:</strong> @p.Allergies</span></div>
                }
            }
            else
            {
                <div class="field" style="margin-bottom:16px;">
                    <label asp-for="PatientPin">Xəstənin FİN-i</label>
                    <input asp-for="PatientPin" class="form-control" maxlength="7" autocomplete="off" style="text-transform:uppercase; max-width:260px;" autofocus />
                    <span asp-validation-for="PatientPin" class="text-danger"></span>
                    <span class="hint-text" id="pinResult">Xəstə kartı yoxdursa, əvvəlcə <a asp-controller="Patient" asp-action="Create">yeni xəstə</a> yaradın.</span>
                </div>
            }

            <div class="form-grid">
                <div class="field">
                    <label asp-for="BedId">Çarpayı</label>
                    <select asp-for="BedId" class="form-select">
                        <option value="">— boş çarpayını seçin —</option>
                        @foreach (var g in Model.FreeBeds.GroupBy(b => b.Ward.Department?.Name ?? "Şöbəsiz"))
                        {
                            <optgroup label="@g.Key">
                                @foreach (var b in g)
                                {
                                    <option value="@b.Id" selected="@(Model.BedId == b.Id)">@b.Ward.Name · çarpayı @b.Name@(b.Ward.Gender != WardGender.Mixed ? $" ({InpatientLabels.Gender(b.Ward.Gender).ToLower(Fmt.Az)})" : "")</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <span asp-validation-for="BedId" class="text-danger"></span>
                    @if (!Model.FreeBeds.Any()) { <span class="hint-text" style="color:var(--bad);">Boş çarpayı yoxdur</span> }
                </div>
                <div class="field">
                    <label asp-for="DoctorId">Müalicə həkimi</label>
                    <select asp-for="DoctorId" class="form-select">
                        <option value="">— seçin —</option>
                        @foreach (var d in Model.Doctors) { <option value="@d.Id">@d.FullName@(d.Specialty != null ? " · " + d.Specialty : "")</option> }
                    </select>
                </div>
                <div class="field">
                    <label>Daxilolma</label>
                    <div class="chip-group">
                        <label class="chip"><input type="radio" name="Type" value="@AdmissionType.Planned" checked="@(Model.Type == AdmissionType.Planned)" /> Planlı</label>
                        <label class="chip"><input type="radio" name="Type" value="@AdmissionType.Emergency" checked="@(Model.Type == AdmissionType.Emergency)" /> Təcili</label>
                    </div>
                </div>
            </div>

            <div class="form-grid mt-3">
                <div class="field">
                    <label asp-for="IcdCode">BXT-10 kodu</label>
                    <input asp-for="IcdCode" class="form-control" list="icdList" maxlength="10" autocomplete="off" placeholder="I10" style="text-transform:uppercase;" />
                    <span asp-validation-for="IcdCode" class="text-danger"></span>
                </div>
                <div class="field" style="grid-column: span 2;">
                    <label asp-for="Diagnosis">Daxilolma diaqnozu</label>
                    <input asp-for="Diagnosis" class="form-control" list="icdNames" maxlength="300" autocomplete="off" />
                    <span asp-validation-for="Diagnosis" class="text-danger"></span>
                </div>
            </div>
            <datalist id="icdList">@foreach (var c in IcdCatalog.Common) { <option value="@c.Value">@c.Name</option> }</datalist>
            <datalist id="icdNames">@foreach (var c in IcdCatalog.Common) { <option value="@c.Name">@c.Value</option> }</datalist>
            <div class="field mt-3">
                <label asp-for="Note">Daxilolma səbəbi, şikayətlər</label>
                <textarea asp-for="Note" class="form-control" rows="3" maxlength="2000"></textarea>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Yerləşdir</button>
                <a class="btn btn-light" asp-action="Index">İmtina</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const codes = new Map([...document.querySelectorAll('#icdList option')].map(o => [o.value.toUpperCase(), o.textContent]));
            const names = new Map([...document.querySelectorAll('#icdNames option')].map(o => [o.value, o.textContent]));
            const code = document.getElementById('IcdCode'), diag = document.getElementById('Diagnosis');
            code.addEventListener('change', () => { const n = codes.get(code.value.trim().toUpperCase()); if (n && (!diag.value || names.has(diag.value))) diag.value = n; });
            diag.addEventListener('change', () => { const c = names.get(diag.value); if (c && !code.value) code.value = c; });

            const pin = document.getElementById('PatientPin'), out = document.getElementById('pinResult');
            if (!pin) return;
            const original = out.innerHTML;
            async function lookup() {
                const v = pin.value.trim();
                if (v.length < 5) { out.innerHTML = original; out.style.color = ''; return; }
                try {
                    const r = await fetch('@Url.Action("Lookup", "Patient")?pin=' + encodeURIComponent(v));
                    if (!r.ok) return;
                    const d = await r.json();
                    if (d.found) { out.textContent = '✓ ' + d.name + ' ' + d.surname + ' · ' + d.birthday.split('-').reverse().join('.'); out.style.color = 'var(--ok)'; }
                    else { out.innerHTML = 'Bu FİN ilə xəstə tapılmadı. ' + original; out.style.color = 'var(--bad)'; }
                } catch { }
            }
            pin.addEventListener('change', lookup);
            pin.addEventListener('blur', lookup);
            if (pin.value) lookup();
        })();
    </script>
}
