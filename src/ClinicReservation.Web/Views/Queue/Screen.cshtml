@{
    Layout = null;
    var departmentId = ViewBag.DepartmentId as int?;
    var department = ViewBag.Department as string;
    var departments = (List<Department>)ViewBag.Departments;
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230E7C74'/%3E%3Cpath d='M6 17h5l2-5 4 10 3-7h6' fill='none' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Növbə ekranı · MedClinic</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <style>
        html, body { height: 100%; }
        body { background: var(--nav-bg); color: #fff; overflow: hidden; }
        .qs { display: grid; grid-template-rows: auto 1fr auto; height: 100vh; padding: 3vh 3vw; gap: 3vh; }
        .qs-head { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
        .qs-brand { display: flex; align-items: center; gap: 14px; font-size: clamp(18px, 2vw, 30px); font-weight: 700; }
        .qs-brand .logo { width: 1.8em; height: 1.8em; border-radius: .45em; background: var(--brand); display: grid; place-items: center; }
        .qs-brand small { display: block; font-size: .55em; font-weight: 500; color: var(--nav-text); }
        .qs-clock { font-size: clamp(28px, 3.6vw, 60px); font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
        .qs-body { display: grid; grid-template-columns: 1.6fr 1fr; gap: 3vw; min-height: 0; }
        .qs-col { display: flex; flex-direction: column; min-height: 0; }
        .qs-col h2 { margin: 0 0 2vh; font-size: clamp(16px, 1.5vw, 26px); font-weight: 600; color: var(--nav-text); text-transform: uppercase; letter-spacing: .08em; }
        .qs-called { display: flex; flex-direction: column; gap: 1.6vh; }
        .qs-call {
            display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 2vw;
            padding: 2.2vh 2vw; border-radius: 18px; background: var(--nav-active);
        }
        .qs-call .tk { font-size: clamp(40px, 5.4vw, 104px); font-weight: 800; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; line-height: 1; }
        .qs-call .arrow { font-size: clamp(28px, 3vw, 56px); color: var(--accent); }
        .qs-call .room { font-size: clamp(26px, 3.2vw, 60px); font-weight: 700; line-height: 1.1; }
        .qs-call .doc { display: block; font-size: clamp(14px, 1.3vw, 24px); font-weight: 500; color: var(--nav-text); margin-top: .3em; }
        .qs-call:first-child { background: var(--brand); }
        .qs-call:first-child .arrow { color: #fff; }
        .qs-call:first-child .doc { color: #D5EFEC; }
        .qs-call.flash { animation: flash 1s ease-in-out 4; }
        @@keyframes flash { 50% { background: var(--accent); color: var(--nav-bg); } }
        .qs-wait { display: grid; grid-template-columns: repeat(auto-fill, minmax(clamp(120px, 11vw, 200px), 1fr)); gap: 1.2vh 1vw; align-content: start; overflow: hidden; }
        .qs-wait div { padding: 1.4vh 1vw; border-radius: 12px; background: var(--nav-hover); text-align: center; }
        .qs-wait strong { display: block; font-size: clamp(22px, 2.4vw, 44px); font-weight: 700; font-variant-numeric: tabular-nums; }
        .qs-wait span { font-size: clamp(11px, .9vw, 16px); color: var(--nav-muted); }
        .qs-empty { color: var(--nav-muted); font-size: clamp(16px, 1.6vw, 28px); padding: 2vh 0; }
        .qs-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; color: var(--nav-muted); font-size: clamp(12px, 1vw, 18px); }
        .qs-tools { display: flex; gap: 8px; align-items: center; }
        .qs-tools select, .qs-tools button {
            height: 34px; border-radius: 8px; border: 1px solid #2A3548; background: var(--nav-hover); color: var(--nav-text);
            padding: 0 10px; font-size: 13px; cursor: pointer;
        }
        .qs-offline { color: #FDA29B; display: none; }
        .qs-offline.show { display: inline; }
        @@media (max-width: 900px) {
            body { overflow: auto; }
            .qs { height: auto; min-height: 100vh; }
            .qs-body { grid-template-columns: 1fr; }
        }
        @@media (prefers-reduced-motion: reduce) { .qs-call.flash { animation: none; outline: 4px solid var(--accent); } }
    </style>
</head>
<body>
    <div class="qs">
        <header class="qs-head">
            <div class="qs-brand">
                <span class="logo"><i class="bi bi-heart-pulse-fill"></i></span>
                <span>MedClinic<small>@(department ?? "Elektron növbə")</small></span>
            </div>
            <div class="qs-clock" id="clock">--:--</div>
        </header>

        <main class="qs-body">
            <section class="qs-col" aria-live="assertive">
                <h2>Qəbula dəvət olunur</h2>
                <div class="qs-called" id="called"><div class="qs-empty">Hələ çağırış yoxdur</div></div>
            </section>
            <section class="qs-col">
                <h2>Növbədə</h2>
                <div class="qs-wait" id="waiting"><div class="qs-empty" style="background:none;">Növbə boşdur</div></div>
            </section>
        </main>

        <footer class="qs-foot">
            <span>Talon nömrənizi ekranda görəndə göstərilən kabinetə və ya pəncərəyə keçin. <span class="qs-offline" id="offline"><i class="bi bi-wifi-off"></i> Bağlantı yoxdur</span></span>
            <span class="qs-tools">
                <select aria-label="Şöbə" onchange="location.search = this.value ? '?departmentId=' + this.value : ''">
                    <option value="">Bütün şöbələr</option>
                    @foreach (var dep in departments)
                    {
                        <option value="@dep.Id" selected="@(dep.Id == departmentId)">@dep.Name</option>
                    }
                </select>
                <button type="button" id="sound" aria-pressed="false"><i class="bi bi-volume-mute"></i> Səs</button>
                <button type="button" onclick="document.documentElement.requestFullscreen?.()"><i class="bi bi-arrows-fullscreen"></i></button>
            </span>
        </footer>
    </div>

    <script>
        (function () {
            const dataUrl = '@Url.Action("Data", new { departmentId })';
            const calledEl = document.getElementById('called');
            const waitingEl = document.getElementById('waiting');
            const offline = document.getElementById('offline');
            const soundBtn = document.getElementById('sound');
            let seen = null, audio = null, soundOn = false;

            // Browsers only allow sound after a click on the page.
            soundBtn.addEventListener('click', () => {
                soundOn = !soundOn;
                audio = audio || new (window.AudioContext || window.webkitAudioContext)();
                soundBtn.setAttribute('aria-pressed', soundOn);
                soundBtn.innerHTML = soundOn ? '<i class="bi bi-volume-up"></i> Səs' : '<i class="bi bi-volume-mute"></i> Səs';
                if (soundOn) chime();
            });

            function chime() {
                if (!soundOn || !audio) return;
                [660, 880].forEach((f, i) => {
                    const o = audio.createOscillator(), g = audio.createGain();
                    o.frequency.value = f; o.connect(g); g.connect(audio.destination);
                    const t = audio.currentTime + i * 0.35;
                    g.gain.setValueAtTime(0.0001, t);
                    g.gain.exponentialRampToValueAtTime(0.4, t + 0.03);
                    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.6);
                    o.start(t); o.stop(t + 0.65);
                });
            }

            // ---- Voice (Azerbaijani): "Talon A on yeddi. Kabinet yüz bir."
            const ones = ['sıfır', 'bir', 'iki', 'üç', 'dörd', 'beş', 'altı', 'yeddi', 'səkkiz', 'doqquz'];
            const tens = ['', 'on', 'iyirmi', 'otuz', 'qırx', 'əlli', 'altmış', 'yetmiş', 'səksən', 'doxsan'];
            function azNumber(n) {
                if (n === 0) return ones[0];
                const parts = [];
                if (n >= 1000) { const k = Math.floor(n / 1000); parts.push(k === 1 ? 'min' : azNumber(k) + ' min'); n %= 1000; }
                if (n >= 100) { const h = Math.floor(n / 100); parts.push(h === 1 ? 'yüz' : ones[h] + ' yüz'); n %= 100; }
                if (n >= 10) { parts.push(tens[Math.floor(n / 10)]); n %= 10; }
                if (n > 0) parts.push(ones[n]);
                return parts.join(' ');
            }
            const letters = { A: 'a', B: 'be', C: 'ce', Ç: 'çe', D: 'de', E: 'e', Ə: 'ə', F: 'fe', G: 'ge', Ğ: 'ğe', H: 'he', X: 'xe', I: 'ı', İ: 'i', J: 'je',
                K: 'ka', Q: 'qe', L: 'el', M: 'em', N: 'en', O: 'o', Ö: 'ö', P: 'pe', R: 'er', S: 'es', Ş: 'şe', T: 'te', U: 'u', Ü: 'ü', V: 've', Y: 'ye', Z: 'ze', W: 'dabl ve' };
            // "KS-004" → "ka es dörd"; numbers inside room names become words too.
            const sayTicket = t => { const [p, n] = (t || '').split('-'); return [...(p || '')].map(c => letters[c] || c).join(' ') + (n ? ' ' + azNumber(parseInt(n, 10)) : ''); };
            const sayText = s => (s || '').replace(/\d+/g, d => ' ' + azNumber(parseInt(d, 10)) + ' ');
            let voice = null;
            function pickVoice() {
                const vs = window.speechSynthesis ? speechSynthesis.getVoices() : [];
                voice = vs.find(v => v.lang?.toLowerCase().startsWith('az')) || vs.find(v => v.lang?.toLowerCase().startsWith('tr')) || null;
            }
            if (window.speechSynthesis) { pickVoice(); speechSynthesis.onvoiceschanged = pickVoice; }
            function announce(calls) {
                if (!soundOn || !window.speechSynthesis) return;
                calls.forEach((c, i) => {
                    const u = new SpeechSynthesisUtterance(`Talon ${sayTicket(c.ticket)}. ${sayText(c.room || 'qəbul')}.`);
                    u.lang = voice?.lang || 'az-AZ';
                    if (voice) u.voice = voice;
                    u.rate = 0.9;
                    // After the chime; each call twice, like a hall announcer.
                    setTimeout(() => { speechSynthesis.speak(u); speechSynthesis.speak(new SpeechSynthesisUtterance(u.text)); }, 1200 + i * 4500);
                });
            }

            const esc = (s) => (s ?? '').toString().replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

            function render(data) {
                document.getElementById('clock').textContent = data.now;
                const keys = data.called.map(c => c.key);
                const fresh = seen === null ? [] : keys.filter(k => !seen.includes(k));
                seen = keys;

                calledEl.innerHTML = data.called.length
                    ? data.called.map(c => `
                        <div class="qs-call ${fresh.includes(c.key) ? 'flash' : ''}">
                            <span class="tk">${esc(c.ticket)}</span>
                            <i class="bi bi-arrow-right arrow" aria-hidden="true"></i>
                            <span class="room">${esc(c.room || 'Qəbul')}<span class="doc">${esc(c.doctor || '')}</span></span>
                        </div>`).join('')
                    : '<div class="qs-empty">Hələ çağırış yoxdur</div>';

                waitingEl.innerHTML = data.waiting.length
                    ? data.waiting.map(w => `<div><strong>${esc(w.ticket)}</strong><span>${w.priority ? '<b style="color:#F97066;">' + esc(w.priority) + '</b> ' : ''}${esc(w.doctor || '')}</span></div>`).join('')
                    : '<div class="qs-empty" style="background:none;">Növbə boşdur</div>';

                if (fresh.length) {
                    chime();
                    announce(data.called.filter(c => fresh.includes(c.key)));
                }
            }

            async function poll() {
                try {
                    const r = await fetch(dataUrl, { cache: 'no-store', headers: { 'Accept': 'application/json' } });
                    if (r.redirected || !r.ok) throw new Error(r.status);
                    render(await r.json());
                    offline.classList.remove('show');
                } catch {
                    offline.classList.add('show');
                }
            }
            poll();
            setInterval(poll, 4000);
        })();
    </script>
</body>
</html>
