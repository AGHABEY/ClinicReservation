@model StockCountViewModel
@{
    ViewData["Title"] = "İnventarizasiya";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var today = DateTime.Today;
}

<div class="page-head">
    <div>
        <h2><i class="bi bi-list-check" style="color:var(--subtle); margin-right:6px;"></i>İnventarizasiya</h2>
        <p>Rəfdəki faktiki miqdarı yazın. Boş saxlanılan sətirlər sayılmamış hesab olunur və dəyişmir.</p>
    </div>
    <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Sənədlər</a>
</div>

@if (Model.Errors.Any())
{
    <div class="alert alert-danger"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
}

<form method="get" class="toolbar">
    <div class="toolbar-right" style="margin-left:0;">
        <select name="warehouseId" class="form-select" aria-label="Anbar" onchange="this.form.submit()" style="max-width:240px;">
            @foreach (var w in Model.Warehouses) { <option value="@w.Id" selected="@(Model.WarehouseId == w.Id)">@w.Name</option> }
        </select>
        <button type="button" class="btn btn-light" onclick="window.print()"><i class="bi bi-printer"></i> Sayım vərəqi</button>
    </div>
</form>

<form asp-action="Count" method="post" novalidate>
    <input type="hidden" name="WarehouseId" value="@Model.WarehouseId" />
    <div class="card">
        @if (Model.Lots.Any())
        {
            <div class="table-scroll">
                <table class="data count-table">
                    <thead><tr><th>Məhsul</th><th class="opt">Seriya</th><th class="opt">Son tarix</th><th class="num">Sistemdə</th><th style="width:150px;">Sayıldı</th><th class="num">Fərq</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.Lots)
                        {
                            var val = Model.Counted.TryGetValue(b.Id, out var c) ? c?.ToString("0.###", inv) : null;
                            <tr class="count-row" data-sys="@b.Quantity.ToString(inv)">
                                <td><span style="font-weight:600;">@b.StockItem.Name</span><div class="hint-text">@b.StockItem.Form<span class="sm-only">@(b.BatchNo != null ? " · " + b.BatchNo : "")@(b.ExpiryDate != null ? " · " + Fmt.Date(b.ExpiryDate) : "") · sistemdə @StockService.Qty(b.Quantity)</span></div></td>
                                <td class="text-muted opt">@(b.BatchNo ?? "—")</td>
                                <td class="opt" style="@(b.ExpiryDate < today ? "color:var(--bad);" : "")">@Fmt.Date(b.ExpiryDate)</td>
                                <td class="num">@StockService.Qty(b.Quantity) <span class="hint-text">@b.StockItem.Unit</span></td>
                                <td><input name="Counted[@b.Id]" value="@val" type="number" step="any" min="0" class="form-control" aria-label="Sayılan miqdar" /></td>
                                <td class="num diff" style="font-weight:600;">—</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-pad" style="padding-top:12px;">
                <div class="field">
                    <label for="Note">Qeyd</label>
                    <textarea id="Note" name="Note" class="form-control" rows="2" maxlength="1000">@Model.Note</textarea>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Nəticəni qeydə al</button>
                    <span class="hint-text" id="countSummary"></span>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state"><i class="bi bi-inbox"></i><p>Bu anbarda qalıq yoxdur</p></div>
        }
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const fmt = { format: v => (v > 0 ? '+' : v < 0 ? '−' : '') + String(+Math.abs(v).toFixed(3)).replace('.', ',') };
            function refresh() {
                let filled = 0, diffs = 0;
                document.querySelectorAll('.count-row').forEach(row => {
                    const input = row.querySelector('input'), cell = row.querySelector('.diff');
                    if (input.value === '') { cell.textContent = '—'; cell.style.color = ''; return; }
                    filled++;
                    const d = parseFloat(input.value) - parseFloat(row.dataset.sys);
                    if (d !== 0) diffs++;
                    cell.textContent = d === 0 ? '0' : fmt.format(d);
                    cell.style.color = d < 0 ? 'var(--bad)' : d > 0 ? 'var(--ok)' : 'var(--subtle)';
                });
                const s = document.getElementById('countSummary');
                if (s) s.textContent = filled ? `${filled} sətir sayıldı, ${diffs} fərq` : '';
            }
            document.addEventListener('input', e => { if (e.target.closest('.count-row')) refresh(); });
            refresh();
        })();
    </script>
}
