@model ExaminationType
@{
    ViewData["Title"] = "Müayinəyə düzəliş";
}

<div class="page-head">
    <div>
        <h2>Müayinəyə düzəliş</h2>
        <p>@Model.Name</p>
    </div>
    <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Siyahıya qayıt</a>
</div>

<div class="card" style="max-width:720px;">
    <div class="card-pad">
        <form asp-action="Edit" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Name">Ad</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Price">Qiymət (₼)</label>
                    <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" inputmode="decimal" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="DepartmentId">Şöbə</label>
                    <select asp-for="DepartmentId" class="form-select" asp-items="@(new SelectList((List<Department>)ViewBag.Departments, "Id", "Name"))">
                        <option value="">— Ümumi —</option>
                    </select>
                </div>
                <div class="field">
                    <label asp-for="DurationMinutes">Müddət, dəq <span class="hint-text">(boş — həkimin bir slotu)</span></label>
                    <input asp-for="DurationMinutes" type="number" min="5" max="480" step="5" class="form-control" />
                    <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="EquipmentId">Avadanlıq <span class="hint-text">(eyni vaxtda yalnız bir qəbul)</span></label>
                    <select asp-for="EquipmentId" class="form-select" asp-items="@(new SelectList((List<Equipment>)ViewBag.Equipment, "Id", "Name"))">
                        <option value="">— lazım deyil —</option>
                    </select>
                </div>
            </div>
            <label class="mt-3" style="display:flex; gap:8px; align-items:center;">
                <input asp-for="FollowUpDiscount" type="checkbox" />
                <span>Kontrol qəbulunda endirim <span class="hint-text">— eyni həkimə qısa müddətdə təkrar gələndə (məs: konsultasiya; analizlər üçün adətən yox)</span></span>
            </label>
            <label class="mt-3" style="display:flex; gap:8px; align-items:center;">
                <input asp-for="OnlineBookable" type="checkbox" />
                <span>Onlayn yazılışda göstər</span>
            </label>
            <div class="field mt-3">
                <label asp-for="Description">Təsvir</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <partial name="_LabTestPicker" />
            <partial name="_MaterialsPicker" />
            <p class="hint-text" style="margin-top:14px;"><i class="bi bi-info-circle"></i> Qiymət dəyişikliyi yalnız yeni rezervasiyalara tətbiq olunur — mövcud rezervasiyaların məbləği dəyişmir.</p>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Yadda saxla</button>
                <a class="btn btn-light" asp-action="Index">İmtina</a>
            </div>
        </form>
    </div>
</div>
