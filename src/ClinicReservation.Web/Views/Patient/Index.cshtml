@model List<PatientRow>
@{
    ViewData["Title"] = "Xəstələr";
    var q = ViewBag.Query as string;
    var pageNo = (int)ViewBag.Page;
    var total = (int)ViewBag.Total;
    var size = (int)ViewBag.PageSize;
    var pages = Math.Max(1, (int)Math.Ceiling(total / (double)size));
}

<div class="page-head">
    <div>
        <h2>Xəstələr</h2>
        <p>@total xəstə kartı@(string.IsNullOrWhiteSpace(q) ? "" : $" · «{q}» üzrə")</p>
    </div>
    @if (User.Can(Permissions.PatientsEdit))
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> Yeni xəstə</a>
    }
</div>

<form method="get" class="toolbar" role="search">
    <div class="search" style="max-width:480px;">
        <i class="bi bi-search"></i>
        <input type="search" name="q" value="@q" class="form-control" placeholder="Ad, soyad, FİN və ya telefon..." aria-label="Axtarış" autofocus />
    </div>
</form>

@if (Model.Any())
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th>Xəstə</th><th>FİN</th><th>Telefon</th><th>Yaş</th><th class="num">Vizit</th><th>Son vizit</th><th>Növbəti qəbul</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <div style="display:flex; align-items:center; gap:10px;">
                                <span class="avatar-sm">@Fmt.Initials(r.Patient.FullName)</span>
                                <a asp-action="Details" asp-route-id="@r.Patient.Id" class="link-strong">@r.Patient.FullName</a>
                            </div>
                        </td>
                        <td class="text-muted">@r.Patient.PinCode</td>
                        <td class="text-muted">@r.Patient.Phone</td>
                        <td class="text-muted">@Fmt.Age(r.Patient.Birthday)</td>
                        <td class="num">@r.Visits</td>
                        <td class="text-muted">@(r.LastVisit == null ? "—" : Fmt.Date(r.LastVisit.Value))</td>
                        <td>@(r.NextVisit == null ? "—" : Fmt.Appointment(r.NextVisit.Value))</td>
                        <td class="actions"><a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@r.Patient.Id">Kart</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (pages > 1)
    {
        <div class="pager">
            <span class="hint-text">@((pageNo - 1) * size + 1)–@Math.Min(pageNo * size, total) / @total</span>
            <div class="page-actions">
                <a class="btn btn-light btn-sm" asp-action="Index" asp-route-q="@q" asp-route-page="@(pageNo - 1)" aria-disabled="@(pageNo <= 1 ? "true" : null)">Əvvəlki</a>
                <a class="btn btn-light btn-sm" asp-action="Index" asp-route-q="@q" asp-route-page="@(pageNo + 1)" aria-disabled="@(pageNo >= pages ? "true" : null)">Növbəti</a>
            </div>
        </div>
    }
}
else
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-person-x"></i>
            <p>@(string.IsNullOrWhiteSpace(q) ? "Hələ xəstə kartı yoxdur — ilk rezervasiya ilə avtomatik yaranır" : "Axtarışa uyğun xəstə tapılmadı")</p>
        </div>
    </div>
}
