@model List<StockItem>
@{
    ViewData["Title"] = "Məhsul kataloqu";
    var kind = ViewBag.Kind as StockItemKind?;
    var q = ViewBag.Query as string;
    var usedIn = ViewBag.UsedIn as Dictionary<int, int> ?? new();
}

<div class="page-head">
    <div>
        <h2>Aptek və anbar</h2>
        <p>Dərman, sərf materialı və reagentlərin kataloqu (@Model.Count)</p>
    </div>
    <div class="page-actions">
        <form asp-action="ImportDefaults" method="post" data-confirm="Standart dərman və materiallar (@StockCatalog.Defaults().Count ədəd) kataloqa əlavə edilsin? Kodu artıq olanlar dəyişmir.">
            <button type="submit" class="btn btn-light"><i class="bi bi-download"></i> Standart siyahını əlavə et</button>
        </form>
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Yeni məhsul</a>
    </div>
</div>

<partial name="_StockNav" />

<div class="toolbar">
    <div class="seg seg-scroll">
        <a class="@(kind == null ? "on" : "")" asp-action="Index" asp-route-q="@q">Hamısı</a>
        @foreach (var k in Enum.GetValues<StockItemKind>())
        {
            <a class="@(kind == k ? "on" : "")" asp-action="Index" asp-route-kind="@k" asp-route-q="@q">@StockLabels.Kind(k)</a>
        }
    </div>
    <form method="get" class="toolbar-right stock-filters">
        <input type="hidden" name="kind" value="@kind" />
        <input type="search" name="q" value="@q" class="form-control" placeholder="Ad və ya kod" aria-label="Axtarış" />
    </form>
</div>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-scroll">
            <table class="data">
                <thead><tr><th>Məhsul</th><th>Kod</th><th>Növ</th><th>Vahid</th><th class="num">Minimum</th><th>Xidmətlər</th><th></th></tr></thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr class="@(i.IsActive ? "" : "row-muted")">
                            <td><a asp-controller="Stock" asp-action="Item" asp-route-id="@i.Id" class="link-strong">@i.Name</a>@(i.IsActive ? "" : " (deaktiv)")<div class="hint-text">@i.Form</div></td>
                            <td>@if (i.Code != null) { <span class="barcode-num">@i.Code</span> } else { <span class="text-muted">—</span> }</td>
                            <td class="text-muted">@StockLabels.Kind(i.Kind)</td>
                            <td class="text-muted">@i.Unit</td>
                            <td class="num text-muted">@(i.MinQuantity > 0 ? StockService.Qty(i.MinQuantity) : "—")</td>
                            <td class="text-muted">@(usedIn.TryGetValue(i.Id, out var c) ? $"{c} müayinə" : "—")</td>
                            <td class="actions"><a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@i.Id">Düzəliş</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-capsule"></i>
            <p>@(q != null || kind != null ? "Seçimə uyğun məhsul yoxdur" : "Kataloq boşdur")</p>
            @if (q == null && kind == null)
            {
                <p class="hint-text" style="margin-top:6px;">«Standart siyahını əlavə et» ilə şpris, əlcək, vakutayner, ampul dərmanlar və reagentləri bir kliklə yükləyin.</p>
            }
        </div>
    }
</div>
