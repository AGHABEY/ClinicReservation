@model AccountViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Giriş · MedClinic</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230E7C74'/%3E%3Cpath d='M6 17h5l2-5 4 10 3-7h6' fill='none' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <style>
        body { background: var(--surface); }
        .login { display: flex; flex-wrap: wrap; min-height: 100vh; }
        .login-aside {
            flex: 1 1 520px;
            background: var(--nav-bg);
            color: #fff;
            padding: 48px 56px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 48px;
        }
        .login-brand { display: flex; align-items: center; gap: 12px; font-size: 18px; font-weight: 700; }
        .login-brand .logo { width: 40px; height: 40px; border-radius: 11px; background: var(--brand); display: grid; place-items: center; font-size: 1.2rem; }
        .login-pitch { display: flex; flex-direction: column; gap: 28px; max-width: 520px; }
        .login-pitch h1 { margin: 0; font-size: 40px; line-height: 1.15; font-weight: 700; letter-spacing: -0.03em; }
        .login-pitch p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--nav-text); }
        .login-features { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
        .login-features li { display: flex; align-items: center; gap: 12px; font-size: 15px; color: #D0D5DD; }
        .login-features i {
            width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0;
            display: grid; place-items: center;
            background: var(--nav-active); color: var(--accent);
        }
        .login-foot { font-size: 13px; color: #8A93A6; }

        .login-main { flex: 1 1 480px; display: flex; align-items: center; justify-content: center; padding: 48px 24px; }
        .login-form { width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 24px; }
        .login-form h2 { margin: 0; font-size: 28px; font-weight: 700; }
        .login-form .sub { margin: 8px 0 0; font-size: 15px; color: var(--subtle); }
        .login-form .field + .field { margin-top: 18px; }
        .input-icon { position: relative; }
        .input-icon i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--subtle); pointer-events: none; }
        .input-icon .form-control { height: 46px; padding-left: 44px; font-size: 15px; }
        .login-form .btn-primary { height: 46px; font-size: 15px; width: 100%; }
        .login-note {
            display: flex; gap: 10px; align-items: flex-start;
            padding: 12px 14px; border-radius: var(--radius-sm);
            background: var(--surface-2); border: 1px solid var(--line);
            font-size: 13px; color: var(--muted); line-height: 1.5;
        }
        .login-note i { color: var(--brand); margin-top: 1px; }
        .login-demo { background: var(--brand-tint); border-color: var(--brand-ring); color: var(--brand-dark); }

        @@media (max-width: 860px) {
            .login-aside { padding: 28px 24px; gap: 24px; }
            .login-pitch h1 { font-size: 26px; }
            .login-pitch p, .login-features, .login-foot { display: none; }
        }
    </style>
</head>
<body>
    <div class="login">
        <section class="login-aside">
            <div class="login-brand">
                <span class="logo"><i class="bi bi-heart-pulse-fill"></i></span>
                MedClinic
            </div>
            <div class="login-pitch">
                <h1>Qəbullar, kassa və hesabatlar — bir paneldə.</h1>
                <p>Rezervasiyaları həkimlərin qrafikinə görə planlayın, ödənişləri qəbul edin və klinikanın gündəlik işini aydın görün.</p>
                <ul class="login-features">
                    <li><i class="bi bi-calendar2-check"></i> Həkim qrafikinə görə boş saatlar</li>
                    <li><i class="bi bi-person-vcard"></i> Hər xəstə üçün vahid kart və tarixçə</li>
                    <li><i class="bi bi-shield-lock"></i> Rollar, icazələr və audit jurnalı</li>
                </ul>
            </div>
            <span class="login-foot">© @ClinicTime.Today.Year MedClinic</span>
        </section>

        <section class="login-main">
            <form class="login-form" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" novalidate>
                <div>
                    <h2>Hesabınıza daxil olun</h2>
                    <p class="sub">İstifadəçi adı və şifrənizi daxil edin.</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="margin:0;"></div>

                <div>
                    <div class="field">
                        <label asp-for="UserName">İstifadəçi adı</label>
                        <div class="input-icon">
                            <i class="bi bi-person"></i>
                            <input class="form-control" asp-for="UserName" placeholder="məs. aynur" autocomplete="username" autofocus>
                        </div>
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Password">Şifrə</label>
                        <div class="input-icon">
                            <i class="bi bi-lock"></i>
                            <input type="password" class="form-control" asp-for="Password" placeholder="••••••••" autocomplete="current-password">
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    Daxil ol <i class="bi bi-arrow-right"></i>
                </button>

                <div class="login-note">
                    <i class="bi bi-shield-check"></i>
                    <span>Şifrənizi unutmusunuzsa, administratora müraciət edin. 5 uğursuz cəhddən sonra hesab bir neçə dəqiqəlik bloklanır.</span>
                </div>

                @if (Env.IsDevelopment())
                {
                    <div class="login-note login-demo">
                        <i class="bi bi-info-circle"></i>
                        <span>Demo: <strong>admin</strong> / <strong>admin123</strong></span>
                    </div>
                }
            </form>
        </section>
    </div>
</body>
</html>
