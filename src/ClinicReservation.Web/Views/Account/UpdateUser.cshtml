@model UpdateUserViewModel
@{
    ViewData["Title"] = "İstifadəçiyə düzəliş";
}

<div class="page-head">
    <div>
        <h2>İstifadəçiyə düzəliş</h2>
        <p>@Model.UserName üçün rol təyin edin</p>
    </div>
    <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Siyahıya qayıt</a>
</div>

<div class="card" style="max-width:560px;">
    <div class="card-pad">
        <form asp-controller="Account" asp-action="UpdateUser" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="field">
                <label for="UserNameDisplay">İstifadəçi adı</label>
                <input id="UserNameDisplay" value="@Model.UserName" class="form-control" readonly />
            </div>
            <div class="field mt-3">
                <label asp-for="RoleId">Rol</label>
                <select class="form-select" asp-for="RoleId" asp-items="@(((List<Microsoft.AspNetCore.Identity.IdentityRole>)ViewBag.Roles).Select(r => new SelectListItem(AppRoles.Label(r.Name), r.Id)))">
                    <option value="">Rol seçin</option>
                </select>
                <span asp-validation-for="RoleId" class="text-danger"></span>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Yenilə</button>
                <a class="btn btn-light" asp-action="Index">İmtina</a>
            </div>
        </form>
    </div>
</div>
