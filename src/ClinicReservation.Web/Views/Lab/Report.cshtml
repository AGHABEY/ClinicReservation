@model LabOrderViewModel
@{
    Layout = null;
    var o = Model.Order;
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230E7C74'/%3E%3Cpath d='M6 17h5l2-5 4 10 3-7h6' fill='none' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Analiz nəticəsi — @o.Patient.FullName — @Fmt.Date(o.CollectedAt)</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; font-family: 'Inter', -apple-system, sans-serif; }
        body { margin: 0; background: #F4F5F7; color: #101828; font-size: 13px; line-height: 1.5; }
        .sheet { width: 210mm; min-height: 297mm; margin: 24px auto; padding: 16mm 16mm 20mm; background: #fff; box-shadow: 0 12px 32px rgba(16,24,40,.12); }
        header { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 12px; border-bottom: 2px solid #0E7C74; }
        .brand { font-size: 20px; font-weight: 700; color: #0E7C74; }
        .brand small { display: block; font-size: 12px; font-weight: 500; color: #475467; }
        .doc-title { text-align: right; }
        .doc-title h1 { margin: 0; font-size: 16px; }
        .doc-title span { color: #475467; font-size: 12px; }
        .tools { text-align: center; margin: 0 0 24px; }
        .tools button { font: 600 14px Inter, sans-serif; height: 40px; padding: 0 18px; border-radius: 10px; border: 0; background: #0E7C74; color: #fff; cursor: pointer; }
        @@media print {
            @@page { size: A4; margin: 0; }
            body { background: #fff; }
            .sheet { margin: 0; box-shadow: none; }
            .tools { display: none; }
        }
    </style>
    <partial name="_LabReportStyles" />
</head>
<body>
    <div class="sheet">
        <header>
            <div class="brand">MedClinic<small>Klinik laboratoriya</small></div>
            <div class="doc-title">
                <h1>Laborator müayinənin nəticəsi</h1>
                <span>№ @o.Barcode</span>
            </div>
        </header>
        <partial name="_LabReport" model="new List<LabOrder> { o }" />
    </div>
    <div class="tools"><button type="button" onclick="window.print()">Çap et / PDF kimi saxla</button></div>
</body>
</html>
